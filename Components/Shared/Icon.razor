@*
    Inline SVG icon set, replacing the emoji entities the site used to render as
    icons. Emoji render as full-colour bitmaps that vary by OS and sit awkwardly
    on the dark theme; these are single-colour strokes that take their size from
    the surrounding font-size (1em) and their colour from `currentColor`, so the
    existing .trust-icon / .service-icon / .info-icon rules keep working.

    Decorative by default (aria-hidden). Pass Label when the icon is the only
    thing conveying meaning — e.g. an icon-only button.
*@

<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Label is null ? "true" : null)"
     role="@(Label is null ? null : "img")" focusable="false">
    @if (Label is not null)
    {
        <title>@Label</title>
    }
    @switch (Name)
    {
        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;

        case "chevron-left":
            <path d="M15 18l-6-6 6-6" />
            break;

        case "chevron-right":
            <path d="M9 18l6-6-6-6" />
            break;

        case "chevron-down":
            <path d="M6 9l6 6 6-6" />
            break;

        case "close":
            <path d="M18 6L6 18M6 6l12 12" />
            break;

        case "arrow-left":
            <path d="M19 12H5" />
            <path d="M12 19l-7-7 7-7" />
            break;

        case "arrow-right":
            <path d="M5 12h14" />
            <path d="M12 5l7 7-7 7" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3.5 2" />
            break;

        case "tag":
            <path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V5a2 2 0 0 1 2-2h7a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.6z" />
            <path d="M7.5 7.5h.01" />
            break;

        case "bike":
            <circle cx="5.5" cy="17" r="3.5" />
            <circle cx="18.5" cy="17" r="3.5" />
            <path d="M5.5 17l4.5-9h5l3.5 9" />
            <path d="M10 8l4.5 9" />
            <path d="M13.5 5H16" />
            break;

        case "star":
            <path d="M12 2.5l2.9 5.9 6.6.9-4.8 4.6 1.2 6.6-5.9-3.1-5.9 3.1 1.2-6.6L2.5 9.3l6.6-.9z"
                  fill="@(Filled ? "currentColor" : "none")" />
            break;

        case "wrench":
            <path d="M14.6 6.4a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.7-3.7a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z" />
            break;

        case "sliders":
            <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3" />
            <path d="M1 14h6M9 8h6M17 16h6" />
            break;

        case "award":
            <circle cx="12" cy="9" r="6" />
            <path d="M8.2 14.3L7 22l5-3 5 3-1.2-7.7" />
            break;

        case "bolt":
            <path d="M13 2L4 14h7l-1 8 9-12h-7z" />
            break;

        case "wheel":
            <circle cx="12" cy="12" r="9" />
            <circle cx="12" cy="12" r="3" />
            break;

        case "link":
            <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
            <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
            break;

        case "phone":
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7 12.8 12.8 0 0 0 .7 2.8 2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4 12.8 12.8 0 0 0 2.8.7 2 2 0 0 1 1.7 2z" />
            break;

        case "mail":
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="M22 6l-10 7L2 6" />
            break;

        case "pin":
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
            break;

        case "camera":
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
            <circle cx="12" cy="13" r="4" />
            break;

        case "calendar":
            <rect x="3" y="4" width="18" height="17" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
            break;

        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 16v-4M12 8h.01" />
            break;

        case "eye":
            <path d="M1.5 12S5.5 4.5 12 4.5 22.5 12 22.5 12 18.5 19.5 12 19.5 1.5 12 1.5 12z" />
            <circle cx="12" cy="12" r="3" />
            break;

        case "graduation":
            <path d="M22 10L12 5 2 10l10 5z" />
            <path d="M6 12v4.5c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V12" />
            break;

        case "bell":
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
            break;

        case "globe":
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18" />
            <path d="M12 3a15.3 15.3 0 0 1 0 18 15.3 15.3 0 0 1 0-18z" />
            break;

        default:
            // Unknown name renders nothing rather than throwing — a typo in a
            // decorative icon shouldn't take a page down.
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// Extra class(es) on the <svg>, for one-off sizing or colour.
    [Parameter] public string? Class { get; set; }

    /// Accessible name. Leave null for decorative icons that sit beside text.
    [Parameter] public string? Label { get; set; }

    /// Only meaningful for "star": solid rather than outlined, for ratings.
    [Parameter] public bool Filled { get; set; }
}
