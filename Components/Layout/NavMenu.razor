@inject NavigationManager Nav
@implements IDisposable

@* The header used to carry a "navbar-scrolled" class driven by a `scrolled` field
   that was never assigned — there was no scroll listener, so the shadow never
   appeared. Rather than add JS interop for a decorative shadow, the border-bottom in
   app.css does the job of separating the bar from the content under it. *@
<header class="navbar-wrapper">
    <nav class="navbar container">
        <a class="navbar-brand" href="/">
            <Logo ImgClass="navbar-logo" />
        </a>

        <button class="hamburger @(menuOpen ? "open" : "")" @onclick="ToggleMenu" aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-links @(menuOpen ? "nav-links--open" : "")">
            <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">Home</NavLink>
            <NavLink href="/services" @onclick="CloseMenu">Services</NavLink>
            <NavLink href="/about" @onclick="CloseMenu">About</NavLink>
            <NavLink href="/gallery" @onclick="CloseMenu">Gallery</NavLink>
            <NavLink href="/contact" @onclick="CloseMenu">Contact</NavLink>

            <AuthorizeView>
                <Authorized>
                    @if (context.User.IsInRole("Admin") || context.User.IsInRole("Worker"))
                    {
                        <NavLink href="/admin" @onclick="CloseMenu">Dashboard</NavLink>
                    }
                    @if (context.User.FindFirst(AuthClaims.UserType)?.Value == AuthClaims.CustomerType)
                    {
                        <NavLink href="/account" @onclick="CloseMenu">My Account</NavLink>
                    }
                    <span class="nav-user">Hi, @context.User.Identity?.Name</span>
                    <a class="nav-auth-link" href="/auth/logout" data-enhance-nav="false">Sign out</a>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-auth-link" href="/account/login" data-enhance-nav="false" @onclick="CloseMenu">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>

            <a class="btn-book" href="/book" @onclick="CloseMenu">Book a Repair</a>
        </div>
    </nav>
</header>

@code {
    private bool menuOpen = false;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
