@inject NavigationManager Nav
@implements IDisposable

@* The header used to carry a "navbar-scrolled" class driven by a `scrolled` field
   that was never assigned — there was no scroll listener, so the shadow never
   appeared. Rather than add JS interop for a decorative shadow, the border-bottom in
   app.css does the job of separating the bar from the content under it. *@
<header class="navbar-wrapper">
    <nav class="navbar container">
        <a class="navbar-brand" href="/">
            <Logo ImgClass="navbar-logo" />
        </a>

        <button class="hamburger @(menuOpen ? "open" : "")" @onclick="ToggleMenu" aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-links @(menuOpen ? "nav-links--open" : "")">
            <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">Home</NavLink>
            <NavLink href="/services" @onclick="CloseMenu">Services</NavLink>
            <NavLink href="/gallery" @onclick="CloseMenu">Gallery</NavLink>
            <NavLink href="/about" @onclick="CloseMenu">About Us</NavLink>

            @* One slot, two states. "Hi, name" and Sign out used to live here too, which
               made eight rows in the phone menu — taller than a handset in landscape.
               Both /account and /admin carry their own Sign Out button in the page
               header, so nothing was lost by taking them out of the bar. *@
            <AuthorizeView>
                <Authorized>
                    <NavLink class="btn-nav" href="@DashboardHref(context.User)" @onclick="CloseMenu">Dashboard</NavLink>
                </Authorized>
                <NotAuthorized>
                    <a class="btn-nav" href="/account/login" data-enhance-nav="false" @onclick="CloseMenu">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>

            <a class="btn-book" href="/book" @onclick="CloseMenu">Book a Repair</a>
        </div>
    </nav>
</header>

@code {
    private bool menuOpen = false;

    /// Staff land on the shop's dashboard, customers on their own. Same claims the
    /// two separate nav entries used to be gated on, now behind one label.
    private static string DashboardHref(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole("Admin") || user.IsInRole("Worker") ? "/admin" : "/account";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
