@inherits LayoutComponentBase

<NavMenu />

<main class="site-main">
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="/" class="footer-logo-link">
                    <Logo ImgClass="footer-logo-img" FallbackClass="footer-logo-text" />
                </a>
                <p>Your neighbourhood bike repair experts. We fix, tune, and transform your ride.</p>
            </div>
            <div class="footer-links">
                <h6>Navigate</h6>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/services">Services</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/gallery">Gallery</a></li>
                    <li><a href="/contact">Contact</a></li>
                </ul>
            </div>
            <div class="footer-contact">
                <h6>Find Us</h6>
                <p><Icon Name="pin" /> 42 Spoke Street, Chainring Quarter</p>
                <p><Icon Name="phone" /> <a href="tel:+447840041100">07840 041100</a></p>
                <p><Icon Name="mail" /> hello&#64;fixlosophy.com</p>
                <p><Icon Name="camera" /> <a href="https://instagram.com/fixlosophy" target="_blank" rel="noopener">&#64;fixlosophy</a></p>
                <p><Icon Name="clock" /> Mon–Fri: 9am – 7pm<br />Sat: 9am – 6pm &middot; Sun: 11am – 5pm</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year Fixlosophy. All rights reserved.</p>
        </div>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x2715;</span>
</div>
