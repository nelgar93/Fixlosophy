@inherits LayoutComponentBase

<NavMenu />

<main class="site-main">
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="/" class="footer-logo-link">
                    <Logo ImgClass="footer-logo-img" FallbackClass="footer-logo-text" />
                </a>
                <p>Your neighbourhood bike repair experts. We fix, tune, and transform your ride.</p>
            </div>
            <div class="footer-links">
                <h6>Navigate</h6>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/services">Services</a></li>
                    <li><a href="/gallery">Gallery</a></li>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/privacy">Privacy</a></li>
                    <li><a href="/terms">Terms</a></li>
                </ul>
            </div>
            <div class="footer-contact">
                <h6>Find Us</h6>
                <p><Icon Name="pin" /> @SiteContent.AddressShort, @SiteContent.AddressPostcode</p>
                <p><Icon Name="phone" /> <a href="tel:@SiteContent.PhoneE164">@SiteContent.PhoneDisplay</a></p>
                <p><Icon Name="mail" /> <a href="mailto:@SiteContent.Email">@SiteContent.Email</a></p>
                <p><Icon Name="camera" /> <a href="@SiteContent.InstagramUrl" target="_blank" rel="noopener">@SiteContent.InstagramHandle</a></p>
                <p>
                    <Icon Name="clock" />
                    @foreach (var line in SiteContent.HoursDisplay)
                    {
                        @line<br />
                    }
                </p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @ShopClock.Today.Year @SiteContent.LegalName. All rights reserved.</p>
        </div>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x2715;</span>
</div>
