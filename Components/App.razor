<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["booking.css"]" />
    <link rel="stylesheet" href="@Assets["Fixlosophy.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="@SupabaseImageUrls.FaviconSvg" />
    <link rel="icon" type="image/png" href="@SupabaseImageUrls.FaviconPng" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Pages are interactive by default; those marked [ExcludeFromInteractiveRouting]
    // (the auth/login pages) render as static SSR so their <form> posts hit the
    // /auth/* endpoints as real HTTP requests that can write the auth cookie.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
