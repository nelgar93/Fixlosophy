@page "/admin/forgot-password"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Forgot Password – Fixlosophy Staff</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="admin-login">
    <div class="admin-login__card">
        <div class="admin-login__logo">
            <Logo ImgClass="admin-logo-img" />
        </div>
        <h2>Reset your password</h2>

        @if (Sent)
        {
            <div class="success-message">
                <div class="success-icon"><Icon Name="check" /></div>
                <h3>Check your inbox</h3>
                <p>If that email belongs to a staff account, we've sent a link to reset your password. It expires in 1 hour. Check your spam folder if you don't see it — you can request another in about a minute.</p>
            </div>
        }
        else
        {
            <p>Enter your staff email and we'll send you a link to reset your password.</p>

            <form method="post" action="/auth/staff-forgot-password">
                <AntiforgeryToken />
                <div class="form-group">
                    <label for="adminforgotpassword-email">Email</label>
                    <input id="adminforgotpassword-email" class="form-control" type="email" name="email" required
                           autocomplete="username" placeholder="staff@fixlosophy.com" />
                </div>
                <button class="btn btn-primary btn-full" type="submit">Send Reset Link</button>
            </form>
        }

        <p class="auth-alt">
            <a href="/admin/login">Back to sign in</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public bool Sent { get; set; }
}
