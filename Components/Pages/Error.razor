@page "/Error"
@using System.Diagnostics

@*
    The stock template's "Development Mode" section used to live here — a paragraph
    from Microsoft to the developer, explaining ASPNETCORE_ENVIRONMENT, shown to
    customers. It said nothing useful to them and advertised the stack, so it's gone.

    What's left: an apology, a way onward, and the request id — kept because it's the
    one thing that makes an emailed "it broke" report actionable.
*@

<PageTitle>Something went wrong – Fixlosophy</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="page-hero page-hero--sm">
    <div class="container">
        <p class="section-eyebrow">Sorry about this</p>
        <h1>Something went wrong</h1>
        <p>We hit a problem processing your request. Nothing you typed has been lost from your account.</p>
    </div>
</div>

<section class="section">
    <div class="container error-page">
        <p>
            Please try again. If it keeps happening, call the shop on
            <a href="tel:@SiteContent.PhoneE164">@SiteContent.PhoneDisplay</a> or email
            <a href="mailto:@SiteContent.Email">@SiteContent.Email</a> — we'll sort it out.
        </p>

        @* Someone who errored mid-booking wants to retry the booking, not read the
           homepage, so /book is offered alongside it. *@
        <div class="error-page__actions">
            <a href="/book" class="btn btn-primary">Try booking again</a>
            <a href="/" class="btn btn-outline">Back to home</a>
        </div>

        @if (ShowRequestId)
        {
            <p class="error-page__ref">
                If you get in touch, quote reference <code>@RequestId</code>.
            </p>
        }
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
