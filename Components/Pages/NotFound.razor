@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found – Fixlosophy</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, follow" />
</HeadContent>

<div class="page-hero page-hero--sm">
    <div class="container">
        <p class="section-eyebrow">Error 404</p>
        <h1>Page Not Found</h1>
        <p>Sorry, the page you're looking for doesn't exist or may have moved.</p>
    </div>
</div>

<section class="section">
    <div class="container error-page">
        <p>
            If you followed a link here, let us know on
            <a href="mailto:@SiteContent.Email">@SiteContent.Email</a> and we'll fix it.
        </p>
        <div class="error-page__actions">
            <a href="/" class="btn btn-primary">Back to home</a>
            <a href="/book" class="btn btn-outline">Book a repair</a>
        </div>
    </div>
</section>
