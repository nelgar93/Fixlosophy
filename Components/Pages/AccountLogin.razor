@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Sign In – Fixlosophy</PageTitle>

<div class="admin-login">
    <div class="admin-login__card">
        <div class="admin-login__logo">
            <Logo ImgClass="admin-logo-img" />
        </div>
        <h2>Welcome back</h2>
        <p>Sign in for faster checkout and to track your bookings.</p>

        @if (Verified)
        {
            <div class="success-message">
                <div class="success-icon">&#10003;</div>
                <p>Your email is verified. You can sign in now.</p>
            </div>
        }
        else if (Resent)
        {
            <div class="success-message">
                <div class="success-icon">&#10003;</div>
                <p>If that account needs verifying, we've sent another link. Check your spam folder if you don't see it — you can request another in about a minute.</p>
            </div>
        }
        else if (Reset)
        {
            <div class="success-message">
                <div class="success-icon">&#10003;</div>
                <p>Your password has been reset. You can sign in now.</p>
            </div>
        }

        @if (Error == "unverified")
        {
            <div class="booking-error">Please verify your email before signing in.</div>
            <form method="post" action="/auth/resend-verification">
                <AntiforgeryToken />
                <input type="hidden" name="email" value="@Email" />
                <button class="btn btn-outline btn-full" type="submit">Resend Verification Email</button>
            </form>
        }
        else if (Error == "verify-failed")
        {
            <div class="booking-error">That verification link is invalid or has expired. Please sign in and request a new one.</div>
        }
        else if (Error is not null)
        {
            <div class="booking-error">Incorrect email or password.</div>
        }

        <form method="post" action="/auth/customer-login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="form-group">
                <label>Email</label>
                <input class="form-control" type="email" name="email" required
                       autocomplete="username" placeholder="you@example.com" value="@Email" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input class="form-control" type="password" name="password" required
                       autocomplete="current-password" placeholder="Your password" />
            </div>
            <label class="remember-row">
                <input type="checkbox" name="remember" value="true" checked />
                <span>Remember me on this device</span>
            </label>
            <p class="auth-alt"><a href="@ForgotPasswordHref">Forgot password?</a></p>
            <button class="btn btn-primary btn-full" type="submit">Sign In</button>
        </form>

        <p class="auth-alt">
            New here? <a href="@RegisterHref">Create an account</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public bool Verified { get; set; }
    [SupplyParameterFromQuery] public bool Resent { get; set; }
    [SupplyParameterFromQuery] public bool Reset { get; set; }

    private string RegisterHref =>
        string.IsNullOrEmpty(ReturnUrl)
            ? "/account/register"
            : $"/account/register?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private string ForgotPasswordHref => "/account/forgot-password";
}
