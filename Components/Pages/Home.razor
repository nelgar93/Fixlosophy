@page "/"
@inject BookingService BookingService
@inject SiteImages Images

<SeoHead Title="@($"Bike Repair Shop in {SiteContent.AddressCity}")"
         Description="@($"Independent bike repairs and servicing at {SiteContent.AddressShort}, {SiteContent.AddressPostcode}. Open seven days, walk-ins welcome. Rated {SiteContent.GoogleRating:0.0} out of 5 by {SiteContent.GoogleReviewCount} riders on Google.")"
         ImageUrl="@Images.Url("shop/shopfront.jpg")" />

<!-- HERO -->
<section class="hero">
    <img class="hero-photo" src="@Images.Url("shop/hero-bikes-outside.jpg")" alt=""
         width="1920" height="1440" fetchpriority="high" decoding="async"
         onerror="this.style.display='none'" />
    <div class="hero-scrim"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <p class="hero-eyebrow">Expert Bike Repairs &amp; Servicing</p>
        <h1 class="hero-title">We Keep You<br /><span>Rolling.</span></h1>
        <p class="hero-subtitle">From flat tyres to full overhauls — Fixlosophy has you covered. Fast, honest, and affordable bike care in the heart of the city.</p>
        <div class="hero-actions">
            <a href="/book" class="btn btn-primary btn-lg">Book a Repair</a>
            <a href="/services" class="btn btn-outline btn-lg">Our Services</a>
        </div>
    </div>
    <div class="hero-scroll-hint"><Icon Name="chevron-down" /></div>
</section>

<!-- TRUST BAR -->
<section class="trust-bar">
    <div class="container trust-bar-grid">
        <div class="trust-item">
            <span class="trust-icon"><Icon Name="clock" /></span>
            <div>
                <strong>Same-Day Service</strong>
                <p>Most repairs done while you wait or by end of day.</p>
            </div>
        </div>
        <div class="trust-item">
            <span class="trust-icon"><Icon Name="tag" /></span>
            <div>
                <strong>Transparent Pricing</strong>
                <p>No hidden fees. You approve the quote before we start.</p>
            </div>
        </div>
        <div class="trust-item">
            <span class="trust-icon"><Icon Name="bike" /></span>
            <div>
                <strong>All Bike Types</strong>
                <p>Road, MTB, gravel, electric, city, BMX — we fix them all.</p>
            </div>
        </div>
        @* Was "5-Star Rated / Trusted by thousands of riders across the city" — an
           unsubstantiated claim under the CAP Code. Replaced with the real figures. *@
        <div class="trust-item">
            <span class="trust-icon"><Icon Name="star" Filled="true" /></span>
            <div>
                <strong>@SiteContent.GoogleRating.ToString("0.0")★ on Google</strong>
                <p>From @SiteContent.GoogleReviewCount reviews by local riders.</p>
            </div>
        </div>
    </div>
</section>

<!-- SERVICES PREVIEW -->
<section class="section services-preview">
    <div class="container">
        <div class="section-header">
            <p class="section-eyebrow">What We Do</p>
            <h2>Popular Services</h2>
            <p class="section-subtitle">Whether you need a quick fix or a full service, our certified mechanics have got you covered.</p>
        </div>
        <div class="services-grid">
            <div class="service-card">
                <div class="service-icon"><Icon Name="wrench" /></div>
                <h3>Basic Service</h3>
                <p>Gear indexing, brake adjustment, tyre pressure check, and chain lube. Your bike back to its best.</p>
                <span class="service-price">From £@_prices.GetValueOrDefault("Basic Service")</span>
            </div>
            <div class="service-card service-card--featured">
                <div class="service-badge">Most Popular</div>
                <div class="service-icon"><Icon Name="sliders" /></div>
                <h3>Full Service</h3>
                <p>Comprehensive overhaul — drivetrain clean, cable check, wheel true, and bearing inspection.</p>
                <span class="service-price">From £@_prices.GetValueOrDefault("Full Service")</span>
            </div>
            <div class="service-card">
                <div class="service-icon"><Icon Name="award" /></div>
                <h3>Gold Service</h3>
                <p>Complete disassembly, deep clean, new cables &amp; housing, bearing repack, and written report.</p>
                <span class="service-price">From £@_prices.GetValueOrDefault("Gold Service")</span>
            </div>
            <div class="service-card">
                <div class="service-icon"><Icon Name="bolt" /></div>
                <h3>Brompton Full Service</h3>
                <p>Specialist full service for Brompton folding bikes, including fold mechanism and hinge inspection.</p>
                <span class="service-price">From £@_prices.GetValueOrDefault("Brompton Full Service")</span>
            </div>
            <div class="service-card">
                <div class="service-icon"><Icon Name="wheel" /></div>
                <h3>Wheel Build</h3>
                <p>Hand-built wheels to order — spoke lacing, tensioning, and truing for road, gravel, or MTB.</p>
                <span class="service-price">From £@_prices.GetValueOrDefault("Wheel Build")</span>
            </div>
            <div class="service-card">
                <div class="service-icon"><Icon Name="link" /></div>
                <h3>Gear Service</h3>
                <p>Front and rear derailleur adjustment for smooth, precise shifting on any drivetrain.</p>
                <span class="service-price">From £@_prices.GetValueOrDefault("Gear Service")</span>
            </div>
        </div>
        <div class="section-cta">
            <a href="/services" class="btn btn-primary">View All Services</a>
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="section how-it-works">
    <div class="container">
        <div class="section-header">
            <p class="section-eyebrow">The Process</p>
            <h2>How It Works</h2>
        </div>
        <div class="steps-grid">
            <div class="step">
                <div class="step-number">01</div>
                <h3>Book Online</h3>
                <p>Fill in our quick form or call us. Tell us what's wrong and we'll confirm your slot.</p>
            </div>
            <div class="step-arrow"><Icon Name="arrow-right" /></div>
            <div class="step">
                <div class="step-number">02</div>
                <h3>Drop Off</h3>
                <p>Bring your bike in. We'll assess it and give you a clear, upfront quote before touching anything.</p>
            </div>
            <div class="step-arrow"><Icon Name="arrow-right" /></div>
            <div class="step">
                <div class="step-number">03</div>
                <h3>We Fix It</h3>
                <p>Our mechanics get to work. You'll get a text when your bike is ready.</p>
            </div>
            <div class="step-arrow"><Icon Name="arrow-right" /></div>
            <div class="step">
                <div class="step-number">04</div>
                <h3>Ride Away</h3>
                <p>Pick up your bike and ride off with confidence. Zero surprises on the bill.</p>
            </div>
        </div>
    </div>
</section>

<!-- SHOP GALLERY TEASER -->
<section class="section shop-preview">
    <div class="container">
        <div class="section-header">
            <p class="section-eyebrow">The Shop</p>
            <h2>Come and See Us</h2>
            <p class="section-subtitle">A proper workshop with bikes out front and hand-painted windows — not a warehouse counter.</p>
        </div>
        <div class="gallery-grid">
            <figure class="gallery-item">
                <img src="@Images.Url("shop/logo-window.jpg")" alt="The Fixlosophy logo painted on the shop window"
                     width="1200" height="900" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/new-bikes.jpg")" alt="A row of new bikes lined up outside the shop"
                     width="1200" height="900" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/window-art.jpg")" alt="Bicycles hand-painted across the shop window"
                     width="1200" height="900" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
            </figure>
        </div>
        <div class="section-cta">
            <a href="/gallery" class="btn btn-outline">See the Shop</a>
        </div>
    </div>
</section>

<!-- REVIEWS -->
@*
    The three testimonial cards that used to sit here were invented — invented names,
    invented quotes, invented five-star ratings. Publishing fabricated consumer reviews
    is a banned practice under the DMCC Act 2024, quite apart from being untrue. What's
    left is the shop's real aggregate rating, linked to the profile it comes from so
    anyone can check it. Update the two figures in SiteContent when they move.
*@
<section class="section reviews">
    <div class="container">
        <div class="section-header">
            <p class="section-eyebrow">Reviews</p>
            <h2>What Riders Say</h2>
        </div>
        <div class="rating-summary">
            <div class="rating-summary__score">@SiteContent.GoogleRating.ToString("0.0")</div>
            <div class="stars" aria-hidden="true">
                <Icon Name="star" Filled="true" /><Icon Name="star" Filled="true" /><Icon Name="star" Filled="true" /><Icon Name="star" Filled="true" /><Icon Name="star" Filled="true" />
            </div>
            <p class="rating-summary__count">
                Rated @SiteContent.GoogleRating.ToString("0.0") out of 5 by
                @SiteContent.GoogleReviewCount riders on Google.
            </p>
            <a href="@SiteContent.GoogleProfileUrl" class="btn btn-outline" target="_blank" rel="noopener">
                Read the reviews
            </a>
        </div>
    </div>
</section>

<!-- CTA BANNER -->
<section class="cta-banner">
    <div class="container cta-banner-content">
        <h2>Ready to get your bike back on the road?</h2>
        <p>Book a repair online or swing by the shop — no appointment needed for quick fixes.</p>
        <div class="cta-actions">
            <a href="/book" class="btn btn-primary btn-lg">Book a Repair</a>
            <a href="tel:@SiteContent.PhoneE164" class="btn btn-ghost btn-lg"><Icon Name="phone" /> Call Us Now</a>
        </div>
    </div>
</section>

@code {
    private Dictionary<string, decimal> _prices = [];

    protected override void OnInitialized()
    {
        _prices = BookingService.GetServices()
            .ToDictionary(s => s.Name, s => s.PriceFrom);
    }
}
