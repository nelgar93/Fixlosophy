@page "/account/register-confirmation"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Check Your Email – Fixlosophy</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="admin-login">
    <div class="admin-login__card">
        <div class="admin-login__logo">
            <Logo ImgClass="admin-logo-img" />
        </div>

        <div class="success-message">
            <div class="success-icon"><Icon Name="check" /></div>
            <h3>Check your inbox</h3>
            <p>We've sent a verification link to your email address. Click it to activate your account, then sign in. Check your spam folder if it doesn't arrive within a minute or two.</p>
        </div>

        <p>Didn't get it? Enter your email to resend the link.</p>

        <form method="post" action="/auth/resend-verification">
            <AntiforgeryToken />
            <div class="form-group">
                <label for="accountregisterconfirmation-email">Email</label>
                <input id="accountregisterconfirmation-email" class="form-control" type="email" name="email" required
                       autocomplete="username" placeholder="you@example.com" />
            </div>
            @* The countdown lives in wwwroot/site.js; the duration is passed through
               the attribute so it can't drift from the server's own cooldown. *@
            <button class="btn btn-outline btn-full" type="submit" id="resend-btn"
                    data-cooldown-seconds="@AuthService.ResendCooldownSeconds">
                Resend Verification Email
            </button>
        </form>

        <p class="auth-alt">
            <a href="@LoginHref">Back to sign in</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string LoginHref =>
        string.IsNullOrEmpty(ReturnUrl)
            ? "/account/login"
            : $"/account/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
