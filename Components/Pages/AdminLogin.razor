@page "/admin/login"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Staff Sign In – Fixlosophy</PageTitle>

<div class="admin-login">
    <div class="admin-login__card">
        <div class="admin-login__logo">
            <Logo ImgClass="admin-logo-img" />
        </div>
        <h2>Staff Access</h2>
        <p>Enter your credentials to access the booking dashboard.</p>

        @if (Reset)
        {
            <div class="success-message">
                <div class="success-icon">&#10003;</div>
                <p>Your password has been reset. You can sign in now.</p>
            </div>
        }

        @if (Error is not null)
        {
            <div class="booking-error">Incorrect email or password.</div>
        }

        <form method="post" action="/auth/staff-login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="form-group">
                <label>Email</label>
                <input class="form-control" type="email" name="email" required
                       autocomplete="username" placeholder="staff@fixlosophy.com" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input class="form-control" type="password" name="password" required
                       autocomplete="current-password" placeholder="Enter password" />
            </div>
            <label class="remember-row">
                <input type="checkbox" name="remember" value="true" checked />
                <span>Remember me on this device</span>
            </label>
            <p class="auth-alt"><a href="/admin/forgot-password">Forgot password?</a></p>
            <button class="btn btn-primary btn-full" type="submit">Sign In</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public bool Reset { get; set; }
}
