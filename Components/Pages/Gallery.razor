@page "/gallery"
@inject SiteImages Images

<PageTitle>The Shop – Fixlosophy Bike Repair</PageTitle>

<div class="page-hero page-hero--sm">
    <div class="container">
        <p class="section-eyebrow">Have a Look Round</p>
        <h1>The Shop</h1>
        <p>Bikes out front, wheels on the wall, and a window we painted ourselves.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="gallery-grid">
            <figure class="gallery-item">
                <img src="@Images.Url("shop/shopfront.jpg")" alt="The blue shopfront with bikes displayed in the window"
                     width="1200" height="900" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
                <figcaption>The blue front — you can't miss it.</figcaption>
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/street-view.jpg")" alt="The full shop seen from the street on a sunny day"
                     width="900" height="1200" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
                <figcaption>Find us tucked between the workshops.</figcaption>
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/bikes-outside.jpg")" alt="Customer bikes lined up outside the Fixlosophy window"
                     width="1200" height="900" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
                <figcaption>A normal morning's queue of jobs.</figcaption>
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/new-bikes.jpg")" alt="A row of new bikes lined up outside the shop"
                     width="1200" height="900" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
                <figcaption>New arrivals, still in their wrapping.</figcaption>
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/logo-window.jpg")" alt="The Fixlosophy logo painted on the shop window"
                     width="1200" height="900" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
                <figcaption>The sign on the glass.</figcaption>
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/window-art.jpg")" alt="Bicycles hand-painted across the shop window"
                     width="1200" height="900" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
                <figcaption>Every bike we love, painted on the window.</figcaption>
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/window-art-detail.jpg")" alt="Close-up of the hand-painted bicycles on the window glass"
                     width="900" height="1200" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
                <figcaption>Tandems, folders and fixies included.</figcaption>
            </figure>
            <figure class="gallery-item">
                <img src="@Images.Url("shop/opening-hours.jpg")" alt="Hand-painted sign showing the shop's opening times"
                     width="900" height="1200" loading="lazy" decoding="async"
                     onerror="this.closest('figure').style.display='none'" />
                <figcaption>Open seven days — including Sunday afternoons.</figcaption>
            </figure>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-banner">
    <div class="container cta-banner-content">
        <h2>Roll in and say hello</h2>
        <p>Walk-ins are welcome for quick fixes, or book a slot online and we'll have the stand ready.</p>
        <div class="cta-actions">
            <a href="/book" class="btn btn-primary btn-lg">Book a Repair</a>
            <a href="/contact" class="btn btn-ghost btn-lg">Get in Touch</a>
        </div>
    </div>
</section>
