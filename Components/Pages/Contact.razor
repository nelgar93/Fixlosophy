@page "/contact"
@rendermode InteractiveServer
@inject ActionRateLimiter RateLimiter
@inject EnquiryService Enquiries
@inject SiteImages Images

<SeoHead Title="Contact Us"
         Description="@($"Call {SiteContent.PhoneDisplay}, email us, or drop into {SiteContent.AddressShort}, {SiteContent.AddressPostcode}. Open seven days — walk-ins welcome for quick repairs.")" />

<div class="page-hero page-hero--sm">
    <div class="container">
        <p class="section-eyebrow">Get In Touch</p>
        <h1>Contact Us</h1>
        <p>Send us a message, call the shop, or just roll in — we're open seven days.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="contact-grid">

            <!-- FORM -->
            <div class="contact-form-wrapper">
                <h2>Send Us a Message</h2>

                @if (submitted)
                {
                    <div class="success-message">
                        <div class="success-icon"><Icon Name="check" /></div>
                        <h3>Thanks, @submittedName!</h3>
                        <p>Your message is with us and we'll get back to you as soon as we can. If it's urgent, call the shop on <a href="tel:@SiteContent.PhoneE164">@SiteContent.PhoneDisplay</a>.</p>
                        <button class="btn btn-outline" @onclick="ResetForm">Send Another</button>
                    </div>
                }
                else
                {
                    <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="contact">
                        <DataAnnotationsValidator />

                        <div class="form-group">
                            <label for="name">Your Name *</label>
                            <InputText id="name" class="form-control" autocomplete="name"
                                       @bind-Value="model.Name" placeholder="e.g. Jane Smith" />
                            <ValidationMessage For="() => model.Name" />
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="email">Email Address *</label>
                                <InputText id="email" class="form-control" type="email"
                                           autocomplete="email" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false"
                                           @bind-Value="model.Email" placeholder="jane@example.com" />
                                <ValidationMessage For="() => model.Email" />
                            </div>
                            <div class="form-group">
                                <label for="phone">Phone (optional)</label>
                                <InputText id="phone" class="form-control" type="tel"
                                           autocomplete="tel" inputmode="tel"
                                           maxlength="@AuthService.MaxPhoneLength" pattern="@AuthService.PhoneInputPattern" data-phone-input
                                           @bind-Value="model.Phone" placeholder="07700 900000" />
                                <ValidationMessage For="() => model.Phone" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="service">Service Required *</label>
                            <InputSelect id="service" class="form-control" @bind-Value="model.Service">
                                <option value="">— Select a service —</option>
                                <option>Flat Tyre Repair</option>
                                <option>Brake Adjustment</option>
                                <option>Gear Indexing</option>
                                <option>Basic Tune-Up</option>
                                <option>Full Service</option>
                                <option>E-Bike Service</option>
                                <option>Safety Check</option>
                                <option>Suspension Service</option>
                                <option>Custom Build</option>
                                <option>Other / Not Sure</option>
                            </InputSelect>
                            <ValidationMessage For="() => model.Service" />
                        </div>

                        <div class="form-group">
                            <label for="bike">Bike Type &amp; Brand (optional)</label>
                            <InputText id="bike" class="form-control" @bind-Value="model.BikeDescription" placeholder="e.g. Trek Marlin 7 MTB, 2021" />
                        </div>

                        <div class="form-group">
                            <label for="message">Describe the Issue *</label>
                            <InputTextArea id="message" class="form-control" rows="5" @bind-Value="model.Message" placeholder="Tell us what's happening with your bike..." />
                            <ValidationMessage For="() => model.Message" />
                        </div>

                        <div class="form-group">
                            <label for="preferred">Preferred Date (optional)</label>
                            <InputDate id="preferred" class="form-control" @bind-Value="model.PreferredDate" />
                        </div>

                        @if (formError != null)
                        {
                            <div class="booking-error">@formError</div>
                        }

                        <p class="form-consent">
                            We'll use these details only to answer your enquiry — see our
                            <a href="/privacy">privacy policy</a>.
                        </p>

                        <button type="submit" class="btn btn-primary btn-lg btn-full" disabled="@sending">
                            @(sending ? "Sending…" : "Send Message")
                        </button>
                    </EditForm>
                }
            </div>

            <!-- INFO SIDEBAR -->
            <div class="contact-info">
                <figure class="contact-photo">
                    <img src="@Images.Url("shop/opening-hours.jpg")" alt="Hand-painted sign in the shop window showing the opening times"
                         width="900" height="1200" loading="lazy" decoding="async"
                         onerror="this.closest('figure').style.display='none'" />
                    <figcaption>Our opening times, straight off the window.</figcaption>
                </figure>

                <div class="info-card">
                    <h3>Visit the Shop</h3>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="pin" /></span>
                        <div>
                            <strong>Address</strong>
                            <p>
                                @SiteContent.AddressVenue<br />
                                @SiteContent.AddressStreet<br />
                                @SiteContent.AddressCity @SiteContent.AddressPostcode
                            </p>
                            <p><a href="@SiteContent.GoogleProfileUrl" target="_blank" rel="noopener">Open in Google Maps</a></p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="clock" /></span>
                        <div>
                            <strong>Opening Hours</strong>
                            <p>
                                @foreach (var line in SiteContent.HoursDisplay)
                                {
                                    @line<br />
                                }
                            </p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="phone" /></span>
                        <div>
                            <strong>Phone</strong>
                            <p><a href="tel:@SiteContent.PhoneE164">@SiteContent.PhoneDisplay</a></p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="mail" /></span>
                        <div>
                            <strong>Email</strong>
                            <p><a href="mailto:@SiteContent.Email">@SiteContent.Email</a></p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="camera" /></span>
                        <div>
                            <strong>Instagram</strong>
                            <p><a href="@SiteContent.InstagramUrl" target="_blank" rel="noopener">@SiteContent.InstagramHandle</a></p>
                        </div>
                    </div>
                </div>

                <div class="info-card">
                    <h3>Walk-Ins Welcome</h3>
                    <p>No appointment needed for quick repairs like flat tyres and minor adjustments. Just roll in during opening hours.</p>
                </div>

                <div class="info-card">
                    <h3>Turnaround Times</h3>
                    <div class="turnaround-list">
                        <div class="turnaround-item">
                            <span>Flat tyre / Quick fix</span>
                            <span class="turnaround-time">Same day</span>
                        </div>
                        <div class="turnaround-item">
                            <span>Basic Tune-Up</span>
                            <span class="turnaround-time">Same day</span>
                        </div>
                        <div class="turnaround-item">
                            <span>Full Service</span>
                            <span class="turnaround-time">1–2 days</span>
                        </div>
                        <div class="turnaround-item">
                            <span>Custom Build</span>
                            <span class="turnaround-time">1–2 weeks</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private ContactModel model = new();
    private bool submitted = false;
    private bool sending = false;
    private string? formError;

    // Kept separately so the thank-you message still has a name after the form is
    // reset, and so it can't be re-read from a model the user has started editing.
    private string submittedName = "";

    private async Task HandleSubmit()
    {
        if (sending) return;
        formError = null;

        if (!RateLimiter.TryAcquire(LimitedAction.ContactMessage))
        {
            formError = "Too many messages in a short time. Please wait a few minutes and try again.";
            return;
        }

        sending = true;
        var stored = await Enquiries.SubmitAsync(new Enquiry
        {
            Name            = model.Name,
            Email           = model.Email,
            Phone           = model.Phone ?? "",
            Service         = model.Service,
            BikeDescription = model.BikeDescription ?? "",
            Message         = model.Message,
            PreferredDate   = model.PreferredDate
        });
        sending = false;

        // Only claim we've received it if we actually have. The previous version said
        // so unconditionally while storing nothing at all.
        if (!stored)
        {
            formError = $"Sorry — we couldn't send that just now. Please call us on {SiteContent.PhoneDisplay} " +
                        $"or email {SiteContent.Email}.";
            return;
        }

        submittedName = model.Name;
        submitted = true;
    }

    private void ResetForm()
    {
        model = new();
        submitted = false;
        formError = null;
    }

    public class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your name.")]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your email.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please enter a valid email.")]
        public string Email { get; set; } = "";

        [PhoneNumber]
        public string? Phone { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please select a service.")]
        public string Service { get; set; } = "";

        public string? BikeDescription { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please describe the issue.")]
        [System.ComponentModel.DataAnnotations.MinLength(10, ErrorMessage = "Please give us a bit more detail.")]
        public string Message { get; set; } = "";

        public DateTime? PreferredDate { get; set; }
    }
}
