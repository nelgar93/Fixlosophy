@page "/book"
@rendermode InteractiveServer
@inject BookingService BookingService
@inject AuthService AuthService
@inject ActionRateLimiter RateLimiter
@inject IStorageService Storage
@inject IEmailSender EmailSender
@inject NotificationService Notifications
@inject NavigationManager Nav
@inject ILogger<Book> Logger

<SeoHead Title="Book a Repair"
         Description="@($"Book a bike repair online in under a minute. Pick a service, choose a slot, and bring your bike to {SiteContent.AddressShort}. Open seven days.")" />

<div class="page-hero page-hero--sm">
    <div class="container">
        <p class="section-eyebrow">Online Booking</p>
        <h1>Book a Repair</h1>
        <p>Pick your service, choose a time, and we'll have you back on the road.</p>
    </div>
</div>

<section class="section booking-section">
    <div class="container">

        <!-- Customer account strip (visible during booking steps) -->
        @if (step < 5)
        {
            <div class="customer-auth-strip">
                @if (loggedInCustomer != null)
                {
                    <span>Signed in as <strong>@loggedInCustomer.FullName</strong></span>
                }
                else
                {
                    <span>Have an account?
                        <a class="customer-auth-strip__link" href="/account/login?returnUrl=%2Fbook"
                           data-enhance-nav="false">Sign in for faster checkout</a>
                    </span>
                }
            </div>
        }

        @if (step < 5)
        {
            <!-- Step indicator -->
            <div class="steps-indicator">
                @foreach (var (label, i) in new[] { "Service", "Schedule", "Details", "Review" }.Select((l, i) => (l, i + 1)))
                {
                    <div class="step-indicator @(step == i ? "active" : step > i ? "done" : "")">
                        <div class="step-indicator__dot">
                            @if (step > i) { <span><Icon Name="check" /></span> }
                            else { <span>@i</span> }
                        </div>
                        <span class="step-indicator__label">@label</span>
                    </div>
                    @if (i < 4)
                    {
                        <div class="step-indicator__line @(step > i ? "done" : "")"></div>
                    }
                }
            </div>
        }

        <!-- STEP 1: SERVICE -->
        @if (step == 1)
        {
            <div class="booking-card">
                <h2 class="booking-card__title">Choose a Service</h2>
                <p class="booking-card__subtitle">Select the type of repair or service you need.</p>

                @foreach (var category in _services.Select(s => s.Category).Distinct())
                {
                    <div class="service-category-group">
                        <h3 class="service-category-label">@category</h3>
                        <div class="service-pick-grid">
                            @* A real <button>, not a <div @onclick>: this is the first
                               control of the booking flow, and as a div it was
                               unreachable by keyboard and announced as nothing in
                               particular. aria-pressed carries the selected state,
                               which the green tick only conveys visually. *@
                            @foreach (var svc in _services.Where(s => s.Category == category))
                            {
                                var isSelected = selectedService?.Name == svc.Name;
                                <button type="button"
                                        class="service-pick-card @(isSelected ? "selected" : "")"
                                        aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                                        @onclick="() => SelectService(svc)">
                                    <span class="service-pick-card__icon"><Icon Name="@CategoryIcon(svc.Category)" /></span>
                                    <span class="service-pick-card__info">
                                        <strong>@svc.Name</strong>
                                        <span>@svc.Duration</span>
                                    </span>
                                    <span class="service-pick-card__price">
                                        @(svc.PriceFrom > 0 ? $"From £{svc.PriceFrom}" : "Quote")
                                    </span>
                                    @if (isSelected)
                                    {
                                        <span class="service-pick-card__check"><Icon Name="check" /></span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="booking-nav">
                    <span></span>
                    <button class="btn btn-primary btn-lg" @onclick="GoToStep2" disabled="@(selectedService == null)">
                        Continue <Icon Name="arrow-right" />
                    </button>
                </div>
            </div>
        }

        <!-- STEP 2: DATE & TIME -->
        @if (step == 2)
        {
            <div class="booking-card">
                <h2 class="booking-card__title">Pick a Date &amp; Time</h2>
                <p class="booking-card__subtitle">We're open @string.Join(" · ", SiteContent.HoursDisplay).</p>

                <div class="schedule-grid">
                    <!-- Calendar -->
                    <div class="calendar-wrapper">
                        <div class="cal-nav">
                            <button class="cal-nav__btn" @onclick="PrevMonth" disabled="@(calendarMonth.Year == ShopClock.Today.Year && calendarMonth.Month == ShopClock.Today.Month)" aria-label="Previous month"><Icon Name="chevron-left" /></button>
                            <span class="cal-nav__title">@calendarMonth.ToString("MMMM yyyy")</span>
                            <button class="cal-nav__btn" @onclick="NextMonth" aria-label="Next month"><Icon Name="chevron-right" /></button>
                        </div>

                        <div class="cal-grid">
                            @foreach (var d in new[] { "Mo", "Tu", "We", "Th", "Fr", "Sa", "Su" })
                            {
                                <div class="cal-head">@d</div>
                            }

                            @for (int i = 0; i < CalFirstDayOffset; i++)
                            {
                                <div class="cal-day cal-day--empty"></div>
                            }

                            @* Buttons rather than divs, and `disabled` rather than a
                               click handler that silently returns — an unavailable day
                               is now skipped by the tab order and announced as
                               unavailable instead of looking identical to a live one.
                               The visible number alone doesn't say which month it's
                               in, so aria-label carries the full date. *@
                            @for (int d = 1; d <= CalDaysInMonth; d++)
                            {
                                var day = d;
                                var date = new DateTime(calendarMonth.Year, calendarMonth.Month, day);
                                var isPast = date.Date < ShopClock.Today;
                                var avail = !isPast && GetDateAvailable(date);
                                var isSelected = selectedDate.HasValue && selectedDate.Value.Date == date.Date;
                                var isToday = date.Date == ShopClock.Today;

                                var css = "cal-day"
                                    + (isSelected ? " cal-day--selected" : "")
                                    + (isToday && !isSelected ? " cal-day--today" : "")
                                    + (avail ? " cal-day--available" : " cal-day--disabled");

                                <button type="button" class="@css"
                                        disabled="@(!avail)"
                                        aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                                        aria-label="@date.ToString("dddd d MMMM yyyy")"
                                        @onclick="() => OnDayClick(date, avail)">@day</button>
                            }
                        </div>
                        <div class="cal-legend">
                            <span class="cal-legend__dot cal-legend__dot--available"></span> Available
                            <span class="cal-legend__dot cal-legend__dot--selected"></span> Selected
                            <span class="cal-legend__dot cal-legend__dot--disabled"></span> Unavailable
                        </div>
                    </div>

                    <!-- Time slots -->
                    <div class="timeslot-wrapper">
                        @if (selectedDate.HasValue)
                        {
                            <h4>@selectedDate.Value.ToString("dddd, d MMMM")</h4>
                            @if (availableSlots.Count == 0)
                            {
                                <p class="timeslot-none">No slots available for this date. Please pick another day.</p>
                            }
                            else
                            {
                                <div class="timeslot-grid">
                                    @foreach (var slot in availableSlots)
                                    {
                                        var s = slot;
                                        <button type="button"
                                                class="timeslot @(selectedTime == s ? "timeslot--selected" : "")"
                                                aria-pressed="@((selectedTime == s).ToString().ToLowerInvariant())"
                                                @onclick="() => selectedTime = s">
                                            @s
                                        </button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="timeslot-prompt">
                                <span><Icon Name="calendar" /></span>
                                <p>Select a date to see available time slots.</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="booking-nav">
                    <button class="btn btn-outline" @onclick="() => GoToStep(1)"><Icon Name="arrow-left" /> Back</button>
                    <button class="btn btn-primary btn-lg" @onclick="GoToStep3" disabled="@(selectedDate == null || selectedTime == null)">
                        Continue <Icon Name="arrow-right" />
                    </button>
                </div>
            </div>
        }

        <!-- STEP 3: DETAILS -->
        @if (step == 3)
        {
            <div class="booking-card">
                <h2 class="booking-card__title">Your Details</h2>
                <p class="booking-card__subtitle">Tell us a bit about yourself and your bike.</p>

                @if (validationError != null)
                {
                    <div class="booking-error">@validationError</div>
                }

                <div class="details-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="booking-name">Full Name *</label>
                            <input id="booking-name" class="form-control" type="text" autocomplete="name"
                                   @bind="customerName" placeholder="e.g. Jane Smith" />
                        </div>
                        <div class="form-group">
                            <label for="booking-email">Email Address *</label>
                            @if (loggedInCustomer is null)
                            {
                                <input id="booking-email" class="form-control" type="email"
                                       autocomplete="email" inputmode="email"
                                       @bind="customerEmail" placeholder="jane@example.com" />
                            }
                            else
                            {
                                @* Read-only: the booking is filed against the account's own
                                   address regardless of what's typed here, so an editable
                                   field would only mislead. *@
                                <input id="booking-email" class="form-control" type="email"
                                       value="@loggedInCustomer.Email" readonly aria-describedby="booking-email-note" />
                                <p id="booking-email-note" class="form-hint">
                                    Your account email. <a href="/auth/logout?returnUrl=%2Fbook" data-enhance-nav="false">Not you?</a>
                                </p>
                            }
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="booking-phone">Phone Number *</label>
                            <input id="booking-phone" class="form-control" type="tel"
                                   autocomplete="tel" inputmode="tel"
                                   @bind="customerPhone" placeholder="07700 900000" required />
                        </div>
                        <div class="form-group">
                            <label for="booking-bike">Bike Make &amp; Model</label>
                            @if (loggedInCustomer?.Bikes.Count > 0)
                            {
                                <div class="bike-chip-row">
                                    @foreach (var bike in loggedInCustomer.Bikes)
                                    {
                                        var b = bike;
                                        <button type="button" class="bike-chip @(bikeDescription == b.MakeModel ? "bike-chip--selected" : "")"
                                                @onclick="() => bikeDescription = b.MakeModel">
                                            @b.MakeModel
                                        </button>
                                    }
                                </div>
                            }
                            <input id="booking-bike" class="form-control" type="text" @bind="bikeDescription" placeholder="e.g. Trek Marlin 7, 2022" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="booking-notes">Describe the Issue</label>
                        <textarea id="booking-notes" class="form-control" rows="4" @bind="notes" placeholder="Any extra details that would help our mechanic prepare..."></textarea>
                    </div>
                    <div class="form-group">
                        <label for="booking-photos">Photos of the Issue (optional, up to @MaxPhotos)</label>
                        <InputFile id="booking-photos" OnChange="OnPhotosSelected" multiple accept="image/jpeg,image/png,image/webp,image/heic" class="form-control" />
                        @if (pendingPhotos.Count > 0)
                        {
                            <ul class="photo-picker-list">
                                @foreach (var photo in pendingPhotos)
                                {
                                    <li>
                                        <span>@photo.FileName</span>
                                        <button type="button" class="photo-picker-remove" @onclick="() => RemovePendingPhoto(photo)">&times;</button>
                                    </li>
                                }
                            </ul>
                        }
                        @if (photoError != null)
                        {
                            <div class="booking-error">@photoError</div>
                        }
                    </div>
                </div>

                <div class="booking-nav">
                    <button class="btn btn-outline" @onclick="() => GoToStep(2)"><Icon Name="arrow-left" /> Back</button>
                    <button class="btn btn-primary btn-lg" @onclick="GoToStep4">Continue <Icon Name="arrow-right" /></button>
                </div>
            </div>
        }

        <!-- STEP 4: REVIEW -->
        @if (step == 4)
        {
            <div class="booking-card">
                <h2 class="booking-card__title">Review Your Booking</h2>
                <p class="booking-card__subtitle">Check everything looks right before we confirm.</p>

                @if (validationError != null)
                {
                    <div class="booking-error">@validationError</div>
                }

                <div class="review-grid">
                    <div class="review-item">
                        <span class="review-label">Service</span>
                        <span class="review-value">@selectedService!.Name</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Category</span>
                        <span class="review-value">@selectedService.Category</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Estimated Price</span>
                        <span class="review-value review-value--green">@(selectedService.PriceFrom > 0 ? $"From £{selectedService.PriceFrom}" : "Quote on arrival")</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Duration</span>
                        <span class="review-value">@selectedService.Duration</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Date</span>
                        <span class="review-value">@selectedDate!.Value.ToString("dddd, d MMMM yyyy")</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Time</span>
                        <span class="review-value">@selectedTime</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Name</span>
                        <span class="review-value">@customerName</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Email</span>
                        <span class="review-value">@customerEmail</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(customerPhone))
                    {
                        <div class="review-item">
                            <span class="review-label">Phone</span>
                            <span class="review-value">@customerPhone</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(bikeDescription))
                    {
                        <div class="review-item">
                            <span class="review-label">Bike</span>
                            <span class="review-value">@bikeDescription</span>
                        </div>
                    }
                </div>

                <div class="review-note">
                    <span><Icon Name="info" /></span>
                    Final price confirmed after assessment. You won't be charged until you approve the quote.
                </div>

                <p class="form-consent">
                    By confirming, you agree to our <a href="/terms">terms</a> and to us using the details
                    above to arrange your repair — see our <a href="/privacy">privacy policy</a>.
                </p>

                <div class="booking-nav">
                    <button class="btn btn-outline" @onclick="() => GoToStep(3)"><Icon Name="arrow-left" /> Back</button>
                    <button class="btn btn-primary btn-lg" @onclick="ConfirmBooking" disabled="@submitting">
                        @(submitting ? "Confirming…" : "Confirm Booking ✓")
                    </button>
                </div>
            </div>
        }

        <!-- STEP 5: CONFIRMED -->
        @if (step == 5 && confirmedBooking != null)
        {
            <div class="booking-confirmed">
                <div class="confirmed-icon"><Icon Name="check" /></div>
                <h2>You're booked in!</h2>
                <p class="confirmed-subtitle">
                    We've sent a confirmation to <strong>@confirmedBooking.CustomerEmail</strong>.
                    Check your spam folder if it doesn't arrive in a few minutes.
                </p>

                @if (photoUploadWarning != null)
                {
                    <div class="booking-error">@photoUploadWarning</div>
                }

                <div class="confirmed-ref">
                    <span>Booking Reference</span>
                    <strong>@confirmedBooking.Reference</strong>
                </div>

                <div class="confirmed-summary">
                    <div class="confirmed-row">
                        <span><Icon Name="wrench" /></span>
                        <div>
                            <strong>@confirmedBooking.ServiceName</strong>
                            <span>@(confirmedBooking.ServicePrice > 0 ? $"From £{confirmedBooking.ServicePrice}" : "Quote on arrival")</span>
                        </div>
                    </div>
                    <div class="confirmed-row">
                        <span><Icon Name="calendar" /></span>
                        <div>
                            <strong>@confirmedBooking.SlotDate.ToString("dddd, d MMMM yyyy")</strong>
                            <span>at @confirmedBooking.SlotTime</span>
                        </div>
                    </div>
                    <div class="confirmed-row">
                        <span><Icon Name="pin" /></span>
                        <div>
                            <strong>@SiteContent.AddressShort</strong>
                            <span>@SiteContent.AddressCity @SiteContent.AddressPostcode &middot; bring your bike 5 minutes early</span>
                        </div>
                    </div>
                </div>

                <div class="confirmed-actions">
                    <a href="/" class="btn btn-primary btn-lg">Back to Home</a>
                    <a href="/book" class="btn btn-outline btn-lg" @onclick="ResetBooking">Book Another</a>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private int step = 1;

    // Step 1
    private List<ServiceOption> _services = [];
    private ServiceOption? selectedService;

    // ServicePricing.Icon holds emoji entities from the original seed data and was
    // rendered here as a MarkupString. Deriving the icon from the category instead
    // keeps the picker consistent with the rest of the site without a data
    // migration, and drops the MarkupString-over-a-DB-value injection risk.
    private static string CategoryIcon(string category) => category switch
    {
        "Servicing Packages" => "wrench",
        "Specialist"         => "bolt",
        "Components"         => "link",
        _                    => "wrench"
    };

    // Step 2
    private DateTime calendarMonth = ShopClock.Today;
    private DateTime? selectedDate;
    private string? selectedTime;
    private List<string> availableSlots = new();
    private Dictionary<DateTime, bool> _monthAvailability = new();

    // Step 3
    private string customerName = "";
    private string customerEmail = "";
    private string customerPhone = "";
    private string bikeDescription = "";
    private string notes = "";
    private string? validationError;

    private const int MaxPhotos = 5;

    /// Total bytes of selected-but-not-yet-uploaded photos allowed per booking form.
    /// MaxPhotos × MaxFileSizeBytes would be 40MB held in server memory for the whole
    /// life of the circuit, per person filling in the form — a cheap way to exhaust a
    /// small VPS. Five typical phone photos land well inside this; five 8MB ones
    /// don't, and get a clear message rather than a slow death.
    private const long MaxTotalPhotoBytes = 16 * 1024 * 1024;

    private long PendingPhotoBytes => pendingPhotos.Sum(p => (long)p.Bytes.Length);

    private List<PendingPhoto> pendingPhotos = new();
    private string? photoError;
    private sealed record PendingPhoto(string FileName, string ContentType, byte[] Bytes);

    // Step 4/5
    private bool submitting = false;
    private Booking? confirmedBooking;
    private string? photoUploadWarning;

    // Customer account — identity comes from the auth cookie (sign-in lives in
    // the nav / dedicated /account pages), we just read it here to prefill.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private Customer? loggedInCustomer;

    // Calendar helpers
    private int CalDaysInMonth => DateTime.DaysInMonth(calendarMonth.Year, calendarMonth.Month);
    private int CalFirstDayOffset
    {
        get
        {
            var first = (int)new DateTime(calendarMonth.Year, calendarMonth.Month, 1).DayOfWeek;
            return first == 0 ? 6 : first - 1;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _services = BookingService.GetServices();

        // If a customer is signed in via the auth cookie, prefill their details.
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            if (user.FindFirst(AuthClaims.UserType)?.Value == AuthClaims.CustomerType)
            {
                var id = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                loggedInCustomer = id is null ? null : AuthService.GetCustomerById(id);
                PrefillCustomerDetails();
            }
        }
    }

    private bool GetDateAvailable(DateTime date) =>
        _monthAvailability.TryGetValue(date.Date, out var avail) && avail;

    private void LoadMonthAvailability()
    {
        _monthAvailability = BookingService.GetDateAvailabilityForMonth(calendarMonth.Year, calendarMonth.Month);
    }

    private void SelectService(ServiceOption svc) => selectedService = svc;

    private void GoToStep(int s)
    {
        if (s == 2)
        {
            LoadMonthAvailability();
            if (selectedDate.HasValue)
                availableSlots = BookingService.GetAvailableSlots(selectedDate.Value);
        }
        step = s;
    }

    private void GoToStep2()
    {
        if (selectedService == null) return;
        LoadMonthAvailability();
        step = 2;
    }

    private void GoToStep3() => step = 3;

    private void GoToStep4()
    {
        validationError = null;
        if (string.IsNullOrWhiteSpace(customerName))
        { validationError = "Please enter your name."; return; }
        if (string.IsNullOrWhiteSpace(customerEmail) || !customerEmail.Contains('@'))
        { validationError = "Please enter a valid email address."; return; }
        // The shop rings or texts when the bike is ready, so a reachable number is
        // required. Counting digits rather than checking for non-empty rejects
        // "call me" and similar, which would otherwise reach the admin panel as a
        // Call/WhatsApp button that goes nowhere.
        if (!AuthService.IsValidPhone(customerPhone))
        { validationError = "Please enter a phone number we can reach you on."; return; }
        step = 4;
    }

    private void OnDayClick(DateTime date, bool available)
    {
        if (!available) return;
        selectedDate = date;
        selectedTime = null;
        availableSlots = BookingService.GetAvailableSlots(date);
        // If all slots are now full (booked since month data was loaded), update the calendar
        if (availableSlots.Count == 0)
            _monthAvailability[date.Date] = false;
    }

    private void PrevMonth()
    {
        var prev = calendarMonth.AddMonths(-1);
        if (prev.Year > ShopClock.Today.Year || (prev.Year == ShopClock.Today.Year && prev.Month >= ShopClock.Today.Month))
        {
            calendarMonth = prev;
            LoadMonthAvailability();
        }
    }

    private void NextMonth()
    {
        calendarMonth = calendarMonth.AddMonths(1);
        LoadMonthAvailability();
    }

    // Reads each selected file into memory (capped by MaxFileSizeBytes) but doesn't
    // touch Supabase Storage yet — uploads only happen once ConfirmBooking has a
    // real booking id, so an abandoned form never orphans files in the bucket.
    private async Task OnPhotosSelected(InputFileChangeEventArgs e)
    {
        photoError = null;

        if (pendingPhotos.Count + e.FileCount > MaxPhotos)
        {
            photoError = $"You can attach up to {MaxPhotos} photos in total.";
            return;
        }

        foreach (var file in e.GetMultipleFiles(MaxPhotos))
        {
            var error = Storage.ValidatePhoto(file.ContentType, file.Size);
            if (error != null) { photoError = error; continue; }

            // Checked before reading, so an oversized batch is refused rather than
            // buffered and then rejected.
            if (PendingPhotoBytes + file.Size > MaxTotalPhotoBytes)
            {
                photoError = $"Those photos come to more than {MaxTotalPhotoBytes / (1024 * 1024)} MB in total. " +
                             "Please attach fewer, or smaller ones.";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(Fixlosophy.Services.StorageService.MaxFileSizeBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                pendingPhotos.Add(new PendingPhoto(file.Name, file.ContentType, buffer.ToArray()));
            }
            catch (IOException)
            {
                photoError = "One of the selected photos couldn't be read.";
            }
        }
    }

    private void RemovePendingPhoto(PendingPhoto photo) => pendingPhotos.Remove(photo);

    private async Task ConfirmBooking()
    {
        if (submitting) return;
        if (selectedService == null || selectedDate == null || selectedTime == null) return;
        validationError = null;
        if (!RateLimiter.TryAcquire(LimitedAction.CreateBooking))
        { validationError = "Too many bookings in a short time. Please wait a few minutes and try again."; return; }
        submitting = true;

        var booking = new Booking
        {
            CustomerName    = customerName,
            // A signed-in customer books against their own account address, whatever
            // the field says. The confirmation email goes to this address, so taking
            // it from the form would let anyone with an account send Fixlosophy-branded
            // mail to an arbitrary recipient. Guests are unaffected.
            CustomerEmail   = loggedInCustomer?.Email ?? customerEmail,
            CustomerPhone   = customerPhone,
            ServiceCategory = selectedService.Category,
            ServiceName     = selectedService.Name,
            ServicePrice    = selectedService.PriceFrom,
            SlotDate        = selectedDate.Value,
            SlotTime        = selectedTime,
            BikeDescription = bikeDescription,
            Notes           = notes,
            CustomerId      = loggedInCustomer?.Id
        };

        var (created, error) = BookingService.CreateBooking(booking);
        if (error != null)
        {
            validationError = error;
            submitting = false;
            return;
        }

        photoUploadWarning = await UploadPendingPhotosAsync(created!.Id);
        await SendBookingEmailsAsync(created);

        confirmedBooking = created;
        step = 5;
        submitting = false;
    }

    // Best-effort, exactly like the photo uploads above: the booking is already
    // committed and the customer is about to be told it's confirmed, so a mail
    // failure gets logged and the flow continues. Each send is caught separately so
    // the shop still hears about the booking when the customer's address bounces.
    private async Task SendBookingEmailsAsync(Booking booking)
    {
        var manageLink = Nav.ToAbsoluteUri(booking.CustomerId is null ? "/contact" : "/account").ToString();

        // Lights up the bell on any open dashboard. Independent of the emails below,
        // so a mail outage still tells whoever is on the shop floor.
        try
        {
            Notifications.RaiseNewBooking(booking);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not raise a notification for booking {Reference}", booking.Reference);
        }

        try
        {
            await EmailSender.SendBookingConfirmationAsync(booking, manageLink);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not email booking confirmation for {Reference}", booking.Reference);
        }

        try
        {
            await EmailSender.SendBookingNotificationAsync(booking, isCancellation: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not email shop notification for {Reference}", booking.Reference);
        }
    }

    // Best-effort: a photo failing to upload never rolls back the booking itself.
    private async Task<string?> UploadPendingPhotosAsync(string bookingId)
    {
        if (pendingPhotos.Count == 0) return null;

        var uploadedPaths = new List<string>();
        var failures = 0;
        foreach (var photo in pendingPhotos)
        {
            var (path, error) = await Storage.UploadCustomerPhotoAsync(bookingId, photo.ContentType, photo.Bytes);
            if (path != null) uploadedPaths.Add(path);
            else failures++;
        }

        if (uploadedPaths.Count > 0)
            BookingService.AddPhotos(bookingId, uploadedPaths);

        // Release the buffers now the bytes are in storage. Without this they stayed
        // resident for the rest of the circuit's life — the confirmation screen doesn't
        // need them, and a customer may leave that tab open for hours.
        pendingPhotos = new();

        return failures == 0 ? null
            : $"{failures} photo{(failures == 1 ? "" : "s")} couldn't be uploaded, but your booking is confirmed.";
    }

    private void ResetBooking()
    {
        step = 1;
        selectedService = null;
        selectedDate = null;
        selectedTime = null;
        availableSlots = new();
        _monthAvailability = new();
        customerName = customerEmail = customerPhone = bikeDescription = notes = "";
        validationError = null;
        confirmedBooking = null;
        calendarMonth = ShopClock.Today;
        pendingPhotos = new();
        photoError = null;
        photoUploadWarning = null;
        // Keep the customer logged in between bookings
    }

    private void PrefillCustomerDetails()
    {
        if (loggedInCustomer == null) return;
        customerName = loggedInCustomer.FullName;
        customerEmail = loggedInCustomer.Email;
        customerPhone = loggedInCustomer.Phone;
        // Only auto-fill when there's exactly one saved bike — with several,
        // guessing which one they mean today would be worse than leaving it blank.
        bikeDescription = loggedInCustomer.Bikes.Count == 1 ? loggedInCustomer.Bikes[0].MakeModel : "";
    }
}
