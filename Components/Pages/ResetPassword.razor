@page "/reset-password"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Reset Password – Fixlosophy</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="admin-login">
    <div class="admin-login__card">
        <div class="admin-login__logo">
            <Logo ImgClass="admin-logo-img" />
        </div>
        <h2>Choose a new password</h2>

        @if (string.IsNullOrEmpty(Token))
        {
            <div class="booking-error">This link is invalid. Please request a new password reset.</div>
        }
        else
        {
            <p>Enter a new password for your account.</p>

            @if (Error is not null)
            {
                <div class="booking-error">@Error</div>
            }

            <form method="post" action="/auth/reset-password">
                <AntiforgeryToken />
                <input type="hidden" name="token" value="@Token" />

                <div class="form-group">
                    <label for="resetpassword-new-password">New Password</label>
                    <div class="password-field">
<input id="resetpassword-new-password" class="form-control" type="password" name="password" required
                           minlength="@AuthService.MinPasswordLength"
                           autocomplete="new-password" placeholder="Choose a new password" />
                    <button type="button" class="password-field__toggle" data-password-toggle="resetpassword-new-password" aria-pressed="false" aria-label="Show password"><Icon Name="eye" /></button>
                </div>
                </div>
                <button class="btn btn-primary btn-full" type="submit">Reset Password</button>
            </form>
        }

        <p class="auth-alt">
            <a href="/account/login">Back to sign in</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
