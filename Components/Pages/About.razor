@page "/about"
@rendermode InteractiveServer
@inject SiteImages Images
@inject ActionRateLimiter RateLimiter
@inject EnquiryService Enquiries

@* Interactive because this page now carries the enquiry form that used to live at
   /contact. Everything above the contact section is still static content. *@

<SeoHead Title="About Us"
         Description="@($"An independent bike shop in {SiteContent.AddressVenue}, {SiteContent.AddressCity}. Honest quotes, no work without your approval, and a proper workshop rather than a warehouse counter. Call {SiteContent.PhoneDisplay} or drop in — open seven days.")" />

<div class="page-hero page-hero--sm">
    <div class="container">
        <p class="section-eyebrow">Our Story</p>
        <h1>About Fixlosophy</h1>
        <p>Born from a love of cycling and a frustration with overpriced, opaque bike shops.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="about-intro">
            <div class="about-text">
                @* The founder story that was here was invented, down to a €400 quote on
                   a site that prices in £. Replaced with copy that only claims things
                   that are actually true. TODO: swap in a real short history from
                   Francesco when you have it. *@
                <h2>Why We Exist</h2>
                <p>Fixlosophy is an independent bike shop in <strong>@SiteContent.AddressVenue</strong>, @SiteContent.AddressCity — a proper workshop with bikes out front and a window we painted ourselves, not a warehouse counter.</p>
                <p>We're built on three simple principles: <strong>honesty, expertise, and speed.</strong> We tell you exactly what's wrong, what it'll cost, and we get it done fast — no waffle, no surprises. You approve the quote before we touch anything.</p>
                <p>We work on everything from beat-up commuters to high-end race machines, and we treat every bike with the same level of care. Because every ride matters.</p>
            </div>
            <div class="about-aside">
                <figure class="about-photo">
                    <img src="@Images.Url("shop/street-view.jpg")" alt="The Fixlosophy shop seen from the street, bikes parked outside"
                         width="900" height="1200" loading="lazy" decoding="async"
                         onerror="this.closest('figure').style.display='none'" />
                    <figcaption>The shop, on a rare sunny afternoon.</figcaption>
                </figure>
                @* "9+ years", "12k+ bikes repaired" and "6 certified mechanics" were
                   all invented — and the team is two people, not six. Only the Google
                   rating survives, because it's the only one that can be checked. *@
                <div class="about-stats about-stats--pair">
                    <div class="stat-card">
                        <div class="stat-number">
                            @SiteContent.GoogleRating.ToString("0.0")<Icon Name="star" Filled="true" Class="stat-star" />
                        </div>
                        <div class="stat-label">Google rating</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">@SiteContent.GoogleReviewCount</div>
                        <div class="stat-label">Reviews</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TEAM -->
<section class="section team-section">
    <div class="container">
        <div class="section-header">
            <p class="section-eyebrow">The People</p>
            <h2>Meet the Team</h2>
            <p class="section-subtitle">Our mechanics are riders themselves — they understand what you need because they ride too.</p>
        </div>
        @* Marco Velo, Aria Lund and Danny Joost did not exist, and neither did their
           certifications. The real team is Francesco and Janek.
           TODO: add a one-line bio for each — what they specialise in — and I'll drop
           it straight in. Until then the cards say only what's true. *@
        <div class="team-grid team-grid--pair">
            @foreach (var member in SiteContent.Team)
            {
                <div class="team-card">
                    <div class="team-avatar">@member[0]</div>
                    <h3>@member</h3>
                    <p class="team-role">Mechanic</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- VALUES -->
<section class="section values-section">
    <div class="container">
        <div class="section-header">
            <p class="section-eyebrow">What We Stand For</p>
            <h2>Our Values</h2>
        </div>
        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon"><Icon Name="eye" /></div>
                <h3>Transparency</h3>
                <p>You'll always know what work needs doing and exactly what it costs before we start. No surprises.</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><Icon Name="graduation" /></div>
                <h3>Expertise</h3>
                <p>Years of workshop experience across road, MTB, e-bikes and folders. We fix bikes because we love bikes.</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><Icon Name="bolt" /></div>
                <h3>Speed</h3>
                <p>We respect your time. Most jobs are done same day. We'll always give you a realistic turnaround upfront.</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><Icon Name="globe" /></div>
                <h3>Sustainability</h3>
                <p>We repair, not replace where possible. We recycle parts, use eco-friendly cleaning products, and love cycling as green transport.</p>
            </div>
        </div>
    </div>
</section>

@* ---- CONTACT ----
   Folded in from the retired /contact page. Two pages said who we are and where we
   are; this one says both. The form that came with it is for questions — booking a
   repair is the wizard's job, and the two used to compete for it. *@
<section class="section contact-section" id="contact">
    <div class="container">
        <div class="section-header">
            <p class="section-eyebrow">Get In Touch</p>
            <h2>Find Us &amp; Say Hello</h2>
            <p class="section-subtitle">Call the shop, send a message, or just roll in — we're open seven days.</p>
        </div>

        <div class="contact-grid">

            <!-- FORM -->
            <div class="contact-form-wrapper">
                <h3>Ask Us Something</h3>
                <p class="contact-form-note">
                    Booking a repair? <a href="/book">Book a repair</a> is quicker — it shows
                    you the prices and the free slots. This form is for everything else.
                </p>

                @if (submitted)
                {
                    <div class="success-message">
                        <div class="success-icon"><Icon Name="check" /></div>
                        <h3>Thanks, @submittedName!</h3>
                        <p>Your message is with us and we'll get back to you as soon as we can. If it's urgent, call the shop on <a href="tel:@SiteContent.PhoneE164">@SiteContent.PhoneDisplay</a>.</p>
                        <button class="btn btn-outline" @onclick="ResetForm">Send Another</button>
                    </div>
                }
                else
                {
                    <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="contact">
                        <DataAnnotationsValidator />

                        <div class="form-group">
                            <label for="name">Your Name *</label>
                            <InputText id="name" class="form-control" autocomplete="name"
                                       @bind-Value="model.Name" placeholder="e.g. Jane Smith" />
                            <ValidationMessage For="() => model.Name" />
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="email">Email Address *</label>
                                <InputText id="email" class="form-control" type="email"
                                           autocomplete="email" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false"
                                           @bind-Value="model.Email" placeholder="jane@example.com" />
                                <ValidationMessage For="() => model.Email" />
                            </div>
                            <div class="form-group">
                                <label for="phone">Phone (optional)</label>
                                <InputText id="phone" class="form-control" type="tel"
                                           autocomplete="tel" inputmode="tel"
                                           maxlength="@AuthService.MaxPhoneLength" pattern="@AuthService.PhoneInputPattern" data-phone-input
                                           @bind-Value="model.Phone" placeholder="07700 900000" />
                                <ValidationMessage For="() => model.Phone" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="bike">Bike Type &amp; Brand (optional)</label>
                            <InputText id="bike" class="form-control" @bind-Value="model.BikeDescription" placeholder="e.g. Trek Marlin 7 MTB, 2021" />
                        </div>

                        <div class="form-group">
                            <label for="message">Your Message *</label>
                            <InputTextArea id="message" class="form-control" rows="5" @bind-Value="model.Message" placeholder="What would you like to know?" />
                            <ValidationMessage For="() => model.Message" />
                        </div>

                        @if (formError != null)
                        {
                            <div class="booking-error">@formError</div>
                        }

                        <p class="form-consent">
                            We'll use these details only to answer your enquiry — see our
                            <a href="/privacy">privacy policy</a>.
                        </p>

                        <button type="submit" class="btn btn-primary btn-lg btn-full" disabled="@sending">
                            @(sending ? "Sending…" : "Send Message")
                        </button>
                    </EditForm>
                }
            </div>

            <!-- INFO SIDEBAR -->
            <div class="contact-info">
                <figure class="contact-photo">
                    <img src="@Images.Url("shop/opening-hours.jpg")" alt="Hand-painted sign in the shop window showing the opening times"
                         width="900" height="1200" loading="lazy" decoding="async"
                         onerror="this.closest('figure').style.display='none'" />
                    <figcaption>Our opening times, straight off the window.</figcaption>
                </figure>

                <div class="info-card">
                    <h3>Visit the Shop</h3>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="pin" /></span>
                        <div>
                            <strong>Address</strong>
                            <p>
                                @SiteContent.AddressVenue<br />
                                @SiteContent.AddressStreet<br />
                                @SiteContent.AddressCity @SiteContent.AddressPostcode
                            </p>
                            <p><a href="@SiteContent.GoogleProfileUrl" target="_blank" rel="noopener">Open in Google Maps</a></p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="clock" /></span>
                        <div>
                            <strong>Opening Hours</strong>
                            <p>
                                @foreach (var line in SiteContent.HoursDisplay)
                                {
                                    @line<br />
                                }
                            </p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="phone" /></span>
                        <div>
                            <strong>Phone</strong>
                            <p><a href="tel:@SiteContent.PhoneE164">@SiteContent.PhoneDisplay</a></p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="mail" /></span>
                        <div>
                            <strong>Email</strong>
                            <p><a href="mailto:@SiteContent.Email">@SiteContent.Email</a></p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon"><Icon Name="camera" /></span>
                        <div>
                            <strong>Instagram</strong>
                            <p><a href="@SiteContent.InstagramUrl" target="_blank" rel="noopener">@SiteContent.InstagramHandle</a></p>
                        </div>
                    </div>
                </div>

                <div class="info-card">
                    <h3>Walk-Ins Welcome</h3>
                    <p>No appointment needed for quick repairs like flat tyres and minor adjustments. Just roll in during opening hours.</p>
                </div>

                <div class="info-card">
                    <h3>Turnaround Times</h3>
                    <div class="turnaround-list">
                        <div class="turnaround-item">
                            <span>Flat tyre / Quick fix</span>
                            <span class="turnaround-time">Same day</span>
                        </div>
                        <div class="turnaround-item">
                            <span>Basic Tune-Up</span>
                            <span class="turnaround-time">Same day</span>
                        </div>
                        <div class="turnaround-item">
                            <span>Full Service</span>
                            <span class="turnaround-time">1–2 days</span>
                        </div>
                        <div class="turnaround-item">
                            <span>Custom Build</span>
                            <span class="turnaround-time">1–2 weeks</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-banner">
    <div class="container cta-banner-content">
        <h2>Come and meet the team</h2>
        <p>Drop in during opening hours or book your repair online. We'd love to see your bike.</p>
        <div class="cta-actions">
            <a href="/book" class="btn btn-primary btn-lg">Book a Repair</a>
            <a href="/services" class="btn btn-ghost btn-lg">View Services</a>
        </div>
    </div>
</section>

@code {
    private ContactModel model = new();
    private bool submitted = false;
    private bool sending = false;
    private string? formError;

    // Kept separately so the thank-you message still has a name after the form is
    // reset, and so it can't be re-read from a model the user has started editing.
    private string submittedName = "";

    private async Task HandleSubmit()
    {
        if (sending) return;
        formError = null;

        if (!RateLimiter.TryAcquire(LimitedAction.ContactMessage))
        {
            formError = "Too many messages in a short time. Please wait a few minutes and try again.";
            return;
        }

        sending = true;
        // Service and PreferredDate stay unset. They were on this form when it read as
        // a booking request; a question about a bike doesn't need a slot picked, and
        // asking for one sent people here instead of through the wizard. The columns
        // remain on Enquiry so the messages already stored keep theirs.
        var stored = await Enquiries.SubmitAsync(new Enquiry
        {
            Name            = model.Name,
            Email           = model.Email,
            Phone           = model.Phone ?? "",
            BikeDescription = model.BikeDescription ?? "",
            Message         = model.Message
        });
        sending = false;

        // Only claim we've received it if we actually have. The previous version said
        // so unconditionally while storing nothing at all.
        if (!stored)
        {
            formError = $"Sorry — we couldn't send that just now. Please call us on {SiteContent.PhoneDisplay} " +
                        $"or email {SiteContent.Email}.";
            return;
        }

        submittedName = model.Name;
        submitted = true;
    }

    private void ResetForm()
    {
        model = new();
        submitted = false;
        formError = null;
    }

    public class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your name.")]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your email.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please enter a valid email.")]
        public string Email { get; set; } = "";

        [PhoneNumber]
        public string? Phone { get; set; }

        public string? BikeDescription { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please tell us what you'd like to know.")]
        [System.ComponentModel.DataAnnotations.MinLength(10, ErrorMessage = "Please give us a bit more detail.")]
        public string Message { get; set; } = "";
    }
}
