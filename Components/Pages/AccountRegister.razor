@page "/account/register"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Create Account – Fixlosophy</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="admin-login">
    <div class="admin-login__card">
        <div class="admin-login__logo">
            <Logo ImgClass="admin-logo-img" />
        </div>
        <h2>Create your account</h2>
        <p>Save your details for faster booking next time.</p>

        @if (Error is not null)
        {
            <div class="booking-error">@Error</div>
        }

        <form method="post" action="/auth/customer-register">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="form-group">
                <label for="register-name">Full Name</label>
                <input id="register-name" class="form-control" type="text" name="fullName" required
                       autocomplete="name" placeholder="Jane Smith" />
            </div>
            <div class="form-group">
                <label for="register-email">Email</label>
                <input id="register-email" class="form-control" type="email" name="email" required
                       autocomplete="username" inputmode="email" placeholder="jane@example.com" />
            </div>
            <div class="form-group">
                <label for="register-phone">Phone</label>
                <input id="register-phone" class="form-control" type="tel" name="phone" required
                       autocomplete="tel" inputmode="tel" placeholder="07700 900000" />
            </div>
            <div class="form-group">
                <label for="register-password">Password</label>
                <div class="password-field">
<input id="register-password" class="form-control" type="password" name="password" required
                       minlength="@AuthService.MinPasswordLength"
                       autocomplete="new-password" placeholder="At least @AuthService.MinPasswordLength characters" />
                    <button type="button" class="password-field__toggle" data-password-toggle="register-password" aria-pressed="false" aria-label="Show password"><Icon Name="eye" /></button>
                </div>
            </div>
            <p class="form-consent">
                By creating an account you agree to our <a href="/terms">terms</a> and
                <a href="/privacy">privacy policy</a>.
            </p>
            <button class="btn btn-primary btn-full" type="submit">Create Account</button>
        </form>

        <p class="auth-alt">
            Already have an account? <a href="@LoginHref">Sign in</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string LoginHref =>
        string.IsNullOrEmpty(ReturnUrl)
            ? "/account/login"
            : $"/account/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
