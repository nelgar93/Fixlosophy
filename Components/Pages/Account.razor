@page "/account"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject BookingService BookingService
@inject BikeService BikeService
@inject ActionRateLimiter RateLimiter
@inject IEmailSender EmailSender
@inject NotificationService Notifications
@inject CustomerService Customers
@inject NavigationManager Nav
@inject ILogger<Account> Logger

<PageTitle>My Account – Fixlosophy</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@if (loggedInCustomer != null)
{
    <div class="page-hero page-hero--sm page-hero--admin">
        <div class="container admin-hero-row">
            <div>
                <p class="section-eyebrow">My Account</p>
                <h1>@loggedInCustomer.FullName</h1>
            </div>
            <div class="admin-header-actions">
                <button class="btn btn-outline" @onclick="Logout">Sign Out</button>
            </div>
        </div>
    </div>

    <section class="section account-section">
        <div class="container">

            <!-- Upcoming Bookings -->
            <div class="booking-card">
                <h2 class="booking-card__title">Upcoming Bookings</h2>
                @if (UpcomingBookings.Count == 0)
                {
                    <p class="booking-card__subtitle">No upcoming bookings. <a href="/book">Book a repair</a></p>
                }
                else
                {
                    @if (cancelError != null)
                    {
                        <div class="booking-error">@cancelError</div>
                    }
                    @if (cancelMessage != null)
                    {
                        <div class="admin-success"><Icon Name="check" /> @cancelMessage</div>
                    }
                    <div class="account-booking-list">
                        @foreach (var booking in UpcomingBookings)
                        {
                            var b = booking;
                            <div class="account-booking-row">
                                <span class="ref-badge">@b.Reference</span>
                                <div class="account-booking-row__info">
                                    <strong>@b.ServiceName</strong>
                                    <span>@b.SlotDate.ToString("d MMM yyyy") &middot; @b.SlotTime</span>
                                    @if (!string.IsNullOrWhiteSpace(b.BikeDescription))
                                    {
                                        <span>@b.BikeDescription</span>
                                    }
                                </div>
                                <div class="account-booking-row__actions">
                                    <span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span>
                                    @if (cancelConfirmId == b.Id)
                                    {
                                        <button class="action-btn action-btn--cancel" @onclick="() => CancelBooking(b.Id)">
                                            Confirm cancel
                                        </button>
                                        <button class="action-btn action-btn--keep" @onclick="() => cancelConfirmId = null">
                                            Keep
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="action-btn action-btn--delete" @onclick="() => StartCancel(b.Id)">
                                            Cancel
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Booking History -->
            @if (BookingHistory.Count > 0)
            {
                <div class="booking-card">
                    <h2 class="booking-card__title">Booking History</h2>
                    <div class="account-booking-list">
                        @foreach (var b in BookingHistory)
                        {
                            <div class="account-booking-row">
                                <span class="ref-badge">@b.Reference</span>
                                <div class="account-booking-row__info">
                                    <strong>@b.ServiceName</strong>
                                    <span>@b.SlotDate.ToString("d MMM yyyy") &middot; @b.SlotTime</span>
                                    @* Notes the mechanic chose to share — the written
                                       report the Gold Service advertises. Internal
                                       notes never reach here. *@
                                    @if (_sharedNotes.TryGetValue(b.Id, out var notes))
                                    {
                                        @foreach (var note in notes)
                                        {
                                            <span class="account-booking-row__note">
                                                <Icon Name="wrench" /> @note
                                            </span>
                                        }
                                    }
                                </div>
                                <span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Your Details -->
            <div class="booking-card">
                <h2 class="booking-card__title">Your Details</h2>
                @if (profileMessage != null)
                {
                    <div class="admin-success"><Icon Name="check" /> @profileMessage</div>
                }
                @if (profileError != null)
                {
                    <div class="booking-error">@profileError</div>
                }
                <div class="form-row">
                    <div class="form-group">
                        <label for="account-full-name">Full Name</label>
                        <input id="account-full-name" class="form-control" type="text" @bind="profileName" />
                    </div>
                    <div class="form-group">
                        <label for="account-email">Email</label>
                        <input id="account-email" class="form-control" type="email" value="@loggedInCustomer.Email" disabled />
                    </div>
                </div>
                <div class="form-group">
                    <label for="account-phone">Phone *</label>
                    <input id="account-phone" class="form-control" type="tel" @bind="profilePhone" required />
                </div>
                <button class="btn btn-primary" @onclick="SaveProfile">Save Details</button>
            </div>

            <!-- Change Password -->
            <div class="booking-card">
                <h2 class="booking-card__title">Change Password</h2>
                @if (passwordMessage != null)
                {
                    <div class="admin-success"><Icon Name="check" /> @passwordMessage</div>
                }
                @if (passwordError != null)
                {
                    <div class="booking-error">@passwordError</div>
                }
                <div class="form-group">
                    <label for="account-current-password">Current Password</label>
                    <input id="account-current-password" class="form-control" type="password" @bind="currentPassword" autocomplete="current-password" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="account-new-password">New Password</label>
                        <input id="account-new-password" class="form-control" type="password" @bind="newPassword" autocomplete="new-password" />
                    </div>
                    <div class="form-group">
                        <label for="account-confirm-new-password">Confirm New Password</label>
                        <input id="account-confirm-new-password" class="form-control" type="password" @bind="confirmPassword" autocomplete="new-password" />
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="SavePassword">Update Password</button>
            </div>

            <!-- Your Bikes -->
            <div class="booking-card">
                <h2 class="booking-card__title">Your Bikes</h2>
                <p class="booking-card__subtitle">Saved bikes appear as quick-select shortcuts when booking a repair.</p>
                @if (bikeError != null)
                {
                    <div class="booking-error">@bikeError</div>
                }
                @if (loggedInCustomer.Bikes.Count > 0)
                {
                    <ul class="photo-picker-list">
                        @foreach (var bike in loggedInCustomer.Bikes)
                        {
                            <li>
                                <span>@bike.MakeModel</span>
                                <button type="button" class="photo-picker-remove" @onclick="() => RemoveBike(bike.Id)">&times;</button>
                            </li>
                        }
                    </ul>
                }
                @* Input and button in their own row rather than .form-row's two-column
                   grid, which stretched the button to the row height and left it
                   misaligned against the field's bottom margin. *@
                <div class="inline-add-row">
                    <label class="sr-only" for="new-bike">Bike make &amp; model</label>
                    <input id="new-bike" class="form-control" type="text" @bind="newBikeName"
                           placeholder="e.g. Trek Marlin 7, 2022" />
                    <button class="btn btn-outline" @onclick="AddBike">Add Bike</button>
                </div>
            </div>

            <!-- Your Data (UK GDPR) -->
            <div class="booking-card">
                <h2 class="booking-card__title">Your Data</h2>
                <p class="booking-card__subtitle">
                    See what we hold about you, or close your account. Our
                    <a href="/privacy">privacy policy</a> explains what we keep and why.
                </p>

                @if (deleteError != null)
                {
                    <div class="booking-error">@deleteError</div>
                }

                <div class="account-data-actions">
                    @* A real link, not a button: the browser has to fetch this over HTTP
                       to receive it as a file — a circuit can't hand over a download. *@
                    <a class="btn btn-outline" href="/account/export" target="_blank"
                       rel="noopener" data-enhance-nav="false">Download my data</a>

                    @if (!confirmingDelete)
                    {
                        <button class="btn btn-danger" @onclick="() => confirmingDelete = true">
                            Delete my account
                        </button>
                    }
                </div>

                @if (confirmingDelete)
                {
                    <div class="account-danger-zone">
                        <p>
                            <strong>This can't be undone.</strong> Your profile, saved bikes and
                            sign-in will be deleted. Past bookings are kept as a record of work
                            carried out, but your name, email, phone number and notes are erased
                            from them.
                        </p>
                        @if (UpcomingBookings.Count > 0)
                        {
                            <p class="account-danger-zone__warning">
                                You have @UpcomingBookings.Count upcoming booking@(UpcomingBookings.Count == 1 ? "" : "s").
                                We'll still expect you — call us on
                                <a href="tel:@SiteContent.PhoneE164">@SiteContent.PhoneDisplay</a> to cancel.
                            </p>
                        }
                        <div class="account-data-actions">
                            <button class="btn btn-danger" @onclick="DeleteAccount" disabled="@deleting">
                                @(deleting ? "Deleting…" : "Yes, delete my account")
                            </button>
                            <button class="btn btn-outline" @onclick="() => confirmingDelete = false">Keep my account</button>
                        </div>
                    </div>
                }
            </div>

        </div>
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private Customer? loggedInCustomer;
    private List<Booking> _bookings = [];

    // BookingId -> notes staff chose to share on that job. Internal notes are
    // filtered out by the query, not here.
    private Dictionary<string, List<string>> _sharedNotes = [];

    private string profileName = "";
    private string profilePhone = "";
    private string? profileMessage;
    private string? profileError;

    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string? passwordMessage;
    private string? passwordError;

    private string newBikeName = "";
    private string? bikeError;

    private bool confirmingDelete;
    private bool deleting;
    private string? deleteError;

    private string? cancelConfirmId;
    private string? cancelError;
    private string? cancelMessage;

    private List<Booking> UpcomingBookings =>
        _bookings.Where(b => b.SlotDate.Date >= ShopClock.Today && b.Status != BookingStatus.Cancelled)
                 .OrderBy(b => b.SlotDate).ThenBy(b => b.SlotTime).ToList();

    private List<Booking> BookingHistory =>
        _bookings.Where(b => !(b.SlotDate.Date >= ShopClock.Today && b.Status != BookingStatus.Cancelled))
                 .OrderByDescending(b => b.SlotDate).ThenByDescending(b => b.SlotTime).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) { RedirectToLogin(); return; }
        var user = (await AuthState).User;
        if (user.FindFirst(AuthClaims.UserType)?.Value != AuthClaims.CustomerType)
        { RedirectToLogin(); return; }

        var id = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        loggedInCustomer = id is null ? null : AuthService.GetCustomerById(id);
        if (loggedInCustomer is null)
        {
            // Cookie says "customer" but the account is gone — clear the stale cookie
            // (same recovery Admin.razor uses when a staff account is deactivated).
            Nav.NavigateTo("/auth/logout", forceLoad: true);
            return;
        }

        LoadProfile();
        LoadBookings();
    }

    private void RedirectToLogin() => Nav.NavigateTo("/account/login?returnUrl=%2Faccount", forceLoad: true);

    private void LoadProfile()
    {
        profileName = loggedInCustomer!.FullName;
        profilePhone = loggedInCustomer.Phone;
    }

    private void LoadBookings()
    {
        _bookings = BookingService.GetBookingsForCustomer(loggedInCustomer!.Id);
        _sharedNotes = Customers.GetCustomerVisibleNotesByBooking(loggedInCustomer.Id);
    }

    private void SaveProfile()
    {
        profileMessage = null;
        profileError = null;
        var (customer, error) = AuthService.UpdateCustomerProfile(loggedInCustomer!.Id, profileName, profilePhone);
        if (error != null) { profileError = error; return; }
        loggedInCustomer = customer;
        LoadProfile();
        profileMessage = "Details saved.";
    }

    private void SavePassword()
    {
        passwordMessage = null;
        passwordError = null;
        if (newPassword != confirmPassword)
        { passwordError = "New passwords don't match."; return; }
        if (!RateLimiter.TryAcquire(LimitedAction.ChangePassword))
        { passwordError = "Too many attempts. Please wait a while and try again."; return; }

        var (ok, error) = AuthService.ChangeCustomerPassword(loggedInCustomer!.Id, currentPassword, newPassword);
        if (!ok) { passwordError = error; return; }
        currentPassword = newPassword = confirmPassword = "";
        passwordMessage = "Password updated.";
    }

    private void AddBike()
    {
        bikeError = null;
        var (bike, error) = BikeService.AddBike(loggedInCustomer!.Id, newBikeName);
        if (error != null) { bikeError = error; return; }
        newBikeName = "";
        loggedInCustomer = AuthService.GetCustomerById(loggedInCustomer.Id);
    }

    private void RemoveBike(string bikeId)
    {
        BikeService.RemoveBike(loggedInCustomer!.Id, bikeId);
        loggedInCustomer = AuthService.GetCustomerById(loggedInCustomer.Id);
    }

    private void Logout() => Nav.NavigateTo("/auth/logout", forceLoad: true);

    private void StartCancel(string bookingId)
    {
        cancelConfirmId = bookingId;
        cancelError = null;
        cancelMessage = null;
    }

    private async Task CancelBooking(string bookingId)
    {
        cancelError = null;
        cancelMessage = null;
        cancelConfirmId = null;

        // customerId goes into the query, so this can only ever touch their own row.
        var (booking, error) = BookingService.CancelOwnBooking(loggedInCustomer!.Id, bookingId);
        if (error != null) { cancelError = error; return; }

        LoadBookings();
        cancelMessage = $"Booking {booking!.Reference} cancelled. The slot is free again.";

        // Best-effort, like the confirmation email: the cancellation is already
        // committed and the slot already freed, so a mail failure must not undo it.
        try
        {
            await EmailSender.SendBookingNotificationAsync(booking, isCancellation: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not notify the shop of cancellation {Reference}", booking.Reference);
        }
    }

    private void DeleteAccount()
    {
        if (deleting) return;
        deleting = true;
        deleteError = null;

        if (!AuthService.DeleteCustomerAccount(loggedInCustomer!.Id))
        {
            deleteError = "We couldn't delete the account just now. Please try again, or email "
                        + SiteContent.Email + " and we'll do it for you.";
            deleting = false;
            return;
        }

        // Sign out on the way past: the cookie now points at a customer row that no
        // longer exists, and leaving it set would bounce them through the stale-cookie
        // recovery path in OnInitializedAsync on the next page load.
        Nav.NavigateTo("/auth/logout?returnUrl=%2F", forceLoad: true);
    }
}
