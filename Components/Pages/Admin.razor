        LoadBookings();
    }

    private async Task ToggleExpand(string id)
    {
        var opening = expandedId != id;
        expandedId = opening ? id : null;
        if (!opening) return;

        var booking = FilteredBookings.FirstOrDefault(b => b.Id == id);
        if (booking is null) return;

        // Photos are no longer eager-loaded with the list — only the row being opened
        // needs them, so they're fetched here and then signed. Job notes ride along
        // for the same reason.
        if (booking.Photos.Count == 0)
            booking.Photos = BookingService.GetPhotosForBooking(booking.Id);

        _bookingNotes[booking.Id] = Customers.GetNotesForBooking(booking.Id);

        foreach (var photo in booking.Photos)
        {
            if (_photoUrls.ContainsKey(photo.Id)) continue;
            var url = await Storage.GetSignedPhotoUrlAsync(photo.StoragePath, TimeSpan.FromMinutes(15));
            if (url is not null) _photoUrls[photo.Id] = url;
        }
    }

    // Debounced: the search box fires on every keystroke, and each one is now a real
    // database query rather than an in-memory filter. 250ms turns a typed word into
    // one round trip instead of eight.
    private async Task OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = new CancellationTokenSource();
        var token = _searchDebounce.Token;

        try
        {
            await Task.Delay(250, token);
        }
        catch (TaskCanceledException)
        {
            return;   // superseded by a later keystroke
        }

        _page = 0;
        expandedId = null;
        CloseTransientPanels();
        LoadBookings();
        await InvokeAsync(StateHasChanged);
    }

    /// Delete-confirm, cancel-confirm and the completion note are three different
    /// two-step flows on the same row. Opening any one closes the others — leaving two
    /// open at once was how a single booking could end up showing twelve controls.
    private void CloseTransientPanels()
    {
        deleteConfirmId = null;
        cancelConfirmId = null;
        openMenuId = null;
        completeNoteBookingId = null;
    }

    private void UpdateStatus(string id, BookingStatus status)
    {
        if (!CanManage) return;  // server-side guard; don't rely on hidden buttons alone
        BookingService.UpdateStatus(id, status);
        CloseTransientPanels();
        LoadBookings();
        RefreshStats();
        LoadCalDay();  // Keep the calendar view in sync when acted on from either tab.
    }

    private void ToggleMenu(string id)
    {
        var opening = openMenuId != id;
        CloseTransientPanels();
        openMenuId = opening ? id : null;
    }

    /// Label for the primary button: the step being taken, not the state it lands in.
    private static string StageLabel(BookingStatus next) => next switch
    {
        BookingStatus.Confirmed  => "Confirm booking",
        BookingStatus.InProgress => "Start work",
        BookingStatus.Completed  => "Mark complete",
        _                        => next.ToString()
    };

    /// The one primary action. Completing is the exception — it opens the note panel
    /// rather than finishing outright, so the mechanic can record what they found.
    private async Task AdvanceStage(Booking booking, BookingStatus next)
    {
        if (!CanManage) return;

        if (next == BookingStatus.Completed)
        {
            StartComplete(booking.Id);
            return;
        }

        UpdateStatus(booking.Id, next);

        // Confirming is the moment the customer's booking becomes real to them, so it
        // is the one stage change worth an email. Starting work isn't — they are
        // already in the diary. Best-effort: the status is committed either way.
        if (next == BookingStatus.Confirmed)
            await NotifyCustomerAsync(booking, isCancellation: false);
    }

    private void StartCancel(string bookingId)
    {
        CloseTransientPanels();
        cancelConfirmId = bookingId;
    }

    private void StartDelete(string bookingId)
    {
        CloseTransientPanels();
        deleteConfirmId = bookingId;
    }

    private async Task CancelBooking(Booking booking)
    {
        if (!CanManage) return;

        UpdateStatus(booking.Id, BookingStatus.Cancelled);

        // RaiseBookingCancelled existed but had no production caller at all, so the
        // bell never showed a cancellation from either side.
        Notifications.RaiseBookingCancelled(booking);
        await NotifyCustomerAsync(booking, isCancellation: true);
    }

    private void ReopenBooking(Booking booking)
    {
        if (!CanManage) return;
        UpdateStatus(booking.Id, BookingStatus.Confirmed);
    }

    /// Best-effort, exactly like the booking confirmation on Book.razor: the status
    /// change is already committed and the slot already freed, so a mail failure must
    /// not undo it or surface as an error on an action that did succeed.
    private async Task NotifyCustomerAsync(Booking booking, bool isCancellation)
    {
        if (string.IsNullOrWhiteSpace(booking.CustomerEmail)) return;
        try
        {
            await EmailSender.SendBookingStatusChangedAsync(booking, isCancellation);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not email {Email} about booking {Reference}",
                booking.CustomerEmail, booking.Reference);
        }
    }

    // ── Completing a job, with an optional note ──────────────────────────────

    private void StartComplete(string bookingId)
    {
        completeNoteBookingId = bookingId;
        completeNoteBody = "";
        completeNoteVisible = false;   // staff-only unless they say otherwise
        deleteConfirmId = null;
    }

    private void CancelCompleteNote()
    {
        completeNoteBookingId = null;
        completeNoteBody = "";
    }

    private void CompleteWithNote(Booking booking)
    {
        if (!CanManage) return;  // server-side guard

        // The note is recorded first: if it fails, the job hasn't been marked done, so
        // a retry is the obvious thing to do. The other order would leave a completed
        // booking whose note silently vanished.
        // AddNote no-ops on an empty body, which is what makes the note optional.
        Customers.AddNote(
            customerId: booking.CustomerId,
            bookingId: booking.Id,
            authorStaffId: loggedInStaff?.Id,
            body: completeNoteBody,
            visibleToCustomer: completeNoteVisible);

        CancelCompleteNote();
        UpdateStatus(booking.Id, BookingStatus.Completed);
    }

