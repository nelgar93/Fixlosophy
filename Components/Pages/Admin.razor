@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Worker")]
@inject BookingService BookingService
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IStorageService Storage

<PageTitle>Admin – Fixlosophy Bookings</PageTitle>

@if (loggedInStaff != null)
{
    <div class="page-hero page-hero--sm page-hero--admin">
        <div class="container admin-hero-row">
            <div>
                <p class="section-eyebrow">@(IsAdmin ? "Admin Dashboard" : "Staff Dashboard")</p>
                <h1>Booking Management</h1>
            </div>
            <div class="admin-header-actions">
                <span class="admin-header-actions__name">
                    @loggedInStaff.FullName &nbsp;·&nbsp;
                    <span class="status-badge status-badge--@(IsAdmin ? "confirmed" : "pending")">
                        @loggedInStaff.Role
                    </span>
                </span>
                <button class="btn btn-outline" @onclick="Logout">Sign Out</button>
            </div>
        </div>
    </div>

    <section class="section admin-section">
        <div class="container">

            <!-- Tab bar -->
            <div class="admin-filter-scroll tab-bar-wrapper">
                <div class="admin-filter-tabs">
                    <button class="filter-tab @(activeTab == "calendar" ? "active" : "")"
                            @onclick="OpenCalendarTab">Calendar</button>
                    <button class="filter-tab @(activeTab == "bookings" ? "active" : "")"
                            @onclick="SetBookingsTab">Bookings</button>
                    @if (IsAdmin)
                    {
                        <button class="filter-tab @(activeTab == "pricing" ? "active" : "")"
                                @onclick="OpenPricingTab">Pricing</button>
                        <button class="filter-tab @(activeTab == "staff" ? "active" : "")"
                                @onclick="OpenStaffTab">Staff Management</button>
                    }
                </div>
            </div>

            <!-- ── BOOKINGS TAB ─────────────────────────────────────────── -->
            @if (activeTab == "bookings")
            {
                <!-- Stats -->
                <div class="admin-stats">
                    <div class="admin-stat">
                        <div class="admin-stat__number">@stats.total</div>
                        <div class="admin-stat__label">@(IsAdmin || loggedInStaff.CanViewAllBookings ? "Total" : "Assigned")</div>
                    </div>
                    <div class="admin-stat admin-stat--highlight">
                        <div class="admin-stat__number">@stats.today</div>
                        <div class="admin-stat__label">Today</div>
                    </div>
                    <div class="admin-stat">
                        <div class="admin-stat__number">@stats.pending</div>
                        <div class="admin-stat__label">Pending</div>
                    </div>
                    <div class="admin-stat">
                        <div class="admin-stat__number">@stats.confirmed</div>
                        <div class="admin-stat__label">Confirmed</div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="admin-filters">
                    <div class="admin-filter-scroll">
                        <div class="admin-filter-tabs">
                            @foreach (var f in Filters)
                            {
                                <button class="filter-tab @(activeFilter == f ? "active" : "")"
                                        @onclick="() => SetFilter(f)">@f</button>
                            }
                        </div>
                    </div>
                    <div class="admin-search">
                        <input class="form-control" type="text" @bind="searchTerm"
                               @oninput="OnSearch" placeholder="Search name, ref, service…" />
                    </div>
                </div>

                @if (TodayBookings.Any() && activeFilter == "All")
                {
                    <div class="today-schedule">
                        <h3>&#128337; Today's Schedule</h3>
                        <div class="today-slots">
                            @foreach (var b in TodayBookings.OrderBy(x => x.SlotTime))
                            {
                                <div class="today-slot">
                                    <span class="today-slot__time">@b.SlotTime</span>
                                    <span class="today-slot__name">@b.CustomerName</span>
                                    <span class="today-slot__service">@b.ServiceName</span>
                                    <span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!FilteredBookings.Any())
                {
                    <div class="admin-empty">
                        <p>No bookings match the current filter.</p>
                    </div>
                }
                else
                {
                    <!-- MOBILE: Card list -->
                    <div class="admin-cards">
                        @foreach (var booking in FilteredBookings)
                        {
                            var b = booking;
                            var isOpen = expandedId == b.Id;
                            <div class="admin-card @(isOpen ? "admin-card--open" : "")" @onclick="() => ToggleExpand(b.Id)">
                                <div class="admin-card__header">
                                    <span class="ref-badge">@b.Reference</span>
                                    <div class="admin-card__header-right">
                                        <span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span>
                                        <span class="admin-card__chevron @(isOpen ? "open" : "")">&#8250;</span>
                                    </div>
                                </div>
                                <div class="admin-card__name">@b.CustomerName</div>
                                <div class="admin-card__meta">
                                    <span>@b.ServiceName</span>
                                    <span>@b.SlotDate.ToString("d MMM") &middot; @b.SlotTime</span>
                                </div>

                                @if (isOpen)
                                {
                                    <div class="admin-card__detail">
                                        @if (CanSeeCustomerDetails)
                                        {
                                            <div class="admin-card__detail-row"><span>Email</span><span>@b.CustomerEmail</span></div>
                                            @if (!string.IsNullOrWhiteSpace(b.CustomerPhone))
                                            {
                                                <div class="admin-card__detail-row"><span>Phone</span><span>@b.CustomerPhone</span></div>
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(b.BikeDescription))
                                        {
                                            <div class="admin-card__detail-row"><span>Bike</span><span>@b.BikeDescription</span></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(b.Notes))
                                        {
                                            <div class="admin-card__detail-row"><span>Notes</span><span>@b.Notes</span></div>
                                        }
                                        @if (b.Photos.Count > 0)
                                        {
                                            <div class="admin-card__detail-row">
                                                <span>Photos</span>
                                                <div class="admin-photo-thumbs">
                                                    @foreach (var photo in b.Photos)
                                                    {
                                                        @if (_photoUrls.TryGetValue(photo.Id, out var url))
                                                        {
                                                            <a href="@url" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">
                                                                <img src="@url" class="admin-photo-thumb" alt="Issue photo" />
                                                            </a>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                        <div class="admin-card__detail-row">
                                            <span>Price</span><span>@(b.ServicePrice > 0 ? $"From £{b.ServicePrice}" : "Quote")</span>
                                        </div>
                                        <div class="admin-card__detail-row">
                                            <span>Booked</span><span>@b.CreatedAt.ToString("d MMM, HH:mm")</span>
                                        </div>
                                        @if (IsAdmin)
                                        {
                                            <div class="admin-card__detail-row">
                                                <span>Assign to</span>
                                                <select class="form-control form-control--compact"
                                                        value="@b.AssignedStaffId"
                                                        @onchange="e => AssignBooking(b.Id, e.Value?.ToString())"
                                                        @onclick:stopPropagation="true">
                                                    <option value="">— Unassigned —</option>
                                                    @foreach (var s in _allStaff.Where(x => x.IsActive))
                                                    {
                                                        <option value="@s.Id">@s.FullName</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (RowHasActions(b))
                                {
                                    <div class="admin-card__actions" @onclick:stopPropagation="true">
                                        @ActionButtons(b)
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- DESKTOP: Table -->
                    <div class="admin-table-wrapper">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Customer</th>
                                    <th>Service</th>
                                    <th>Date &amp; Time</th>
                                    <th>Status</th>
                                    @if (IsAdmin) { <th>Assigned To</th> }
                                    @if (CanManage || CanSeeCustomerDetails) { <th>Actions</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in FilteredBookings)
                                {
                                    var b = booking;
                                    <tr class="@(expandedId == b.Id ? "row-expanded" : "")" @onclick="() => ToggleExpand(b.Id)">
                                        <td><span class="ref-badge">@b.Reference</span></td>
                                        <td>
                                            <div class="customer-cell">
                                                <strong>@b.CustomerName</strong>
                                                @if (CanSeeCustomerDetails)
                                                {
                                                    <span>@b.CustomerEmail</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="service-cell">
                                                <strong>@b.ServiceName</strong>
                                                <span>@(b.ServicePrice > 0 ? $"£{b.ServicePrice}" : "Quote")</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="date-cell">
                                                <strong>@b.SlotDate.ToString("d MMM yyyy")</strong>
                                                <span>@b.SlotTime</span>
                                            </div>
                                        </td>
                                        <td><span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span></td>
                                        @if (IsAdmin)
                                        {
                                            <td @onclick:stopPropagation="true">
                                                <select class="form-control form-control--compact" style="min-width:130px"
                                                        value="@b.AssignedStaffId"
                                                        @onchange="e => AssignBooking(b.Id, e.Value?.ToString())">
                                                    <option value="">— Unassigned —</option>
                                                    @foreach (var s in _allStaff.Where(x => x.IsActive))
                                                    {
                                                        <option value="@s.Id">@s.FullName</option>
                                                    }
                                                </select>
                                            </td>
                                        }
                                        @if (CanManage || CanSeeCustomerDetails)
                                        {
                                            <td @onclick:stopPropagation="true">
                                                <div class="action-buttons">
                                                    @ActionButtons(b)
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                    @if (expandedId == b.Id && CanSeeCustomerDetails)
                                    {
                                        <tr class="row-detail">
                                            <td colspan="@BookingColumnCount">
                                                <div class="booking-detail">
                                                    <div class="booking-detail__grid">
                                                        <div><strong>Phone</strong><span>@(string.IsNullOrWhiteSpace(b.CustomerPhone) ? "—" : b.CustomerPhone)</span></div>
                                                        <div><strong>Bike</strong><span>@(string.IsNullOrWhiteSpace(b.BikeDescription) ? "—" : b.BikeDescription)</span></div>
                                                        <div><strong>Booked</strong><span>@b.CreatedAt.ToString("d MMM yyyy, HH:mm")</span></div>
                                                        <div><strong>Notes</strong><span>@(string.IsNullOrWhiteSpace(b.Notes) ? "—" : b.Notes)</span></div>
                                                    </div>
                                                    @if (b.Photos.Count > 0)
                                                    {
                                                        <div class="booking-detail__photos">
                                                            <strong>Photos</strong>
                                                            <div class="admin-photo-thumbs">
                                                                @foreach (var photo in b.Photos)
                                                                {
                                                                    @if (_photoUrls.TryGetValue(photo.Id, out var url))
                                                                    {
                                                                        <a href="@url" target="_blank" rel="noopener noreferrer">
                                                                            <img src="@url" class="admin-photo-thumb" alt="Issue photo" />
                                                                        </a>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            <!-- ── CALENDAR TAB ──────────────────────────────────────────── -->
            @if (activeTab == "calendar")
            {
                <div class="day-cal">
                    <div class="day-cal__nav">
                        <button class="cal-nav__btn" @onclick="() => ChangeCalDay(-1)">&#8592;</button>
                        <div class="day-cal__title">
                            <strong>@calDay.ToString("dddd, d MMMM yyyy")</strong>
                            @if (calDay.Date == DateTime.Today)
                            {
                                <span class="status-badge status-badge--confirmed">Today</span>
                            }
                        </div>
                        <button class="cal-nav__btn" @onclick="() => ChangeCalDay(1)">&#8594;</button>
                        <input type="date" class="form-control day-cal__picker"
                               value="@calDay.ToString("yyyy-MM-dd")" @onchange="OnCalDatePicked" />
                        @if (calDay.Date != DateTime.Today)
                        {
                            <button class="btn btn-outline" @onclick="() => SetCalDay(DateTime.Today)">Today</button>
                        }
                    </div>

                    <div class="day-cal__summary">
                        <span><strong>@_calDayBookings.Count</strong> booking@(_calDayBookings.Count == 1 ? "" : "s")</span>
                        @if (_calDayBookings.Any(b => b.Status == BookingStatus.Pending))
                        {
                            <span class="status-badge status-badge--pending">@_calDayBookings.Count(b => b.Status == BookingStatus.Pending) pending</span>
                        }
                        @if (calDay.DayOfWeek == DayOfWeek.Sunday)
                        {
                            <span class="day-cal__closed">Sunday hours — 11am to 5pm</span>
                        }
                    </div>

                    <div class="day-cal__slots">
                        @foreach (var slot in BookingService.SlotsFor(calDay))
                        {
                            var slotBookings = _calDayBookings.Where(b => b.SlotTime == slot).ToList();
                            <div class="day-cal-slot @(slotBookings.Count == 0 ? "day-cal-slot--free" : "")">
                                <div class="day-cal-slot__time">@slot</div>
                                <div class="day-cal-slot__content">
                                    @if (slotBookings.Count == 0)
                                    {
                                        <span class="day-cal-slot__free">Free</span>
                                    }
                                    else
                                    {
                                        @foreach (var booking in slotBookings)
                                        {
                                            var b = booking;
                                            <div class="day-cal-booking @(b.Status == BookingStatus.Cancelled ? "day-cal-booking--cancelled" : "")">
                                                <div class="day-cal-booking__info">
                                                    <div class="day-cal-booking__head">
                                                        <strong>@b.CustomerName</strong>
                                                        <span class="ref-badge">@b.Reference</span>
                                                        <span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span>
                                                    </div>
                                                    <div class="day-cal-booking__meta">
                                                        <span>@b.ServiceName</span>
                                                        @if (!string.IsNullOrWhiteSpace(b.BikeDescription))
                                                        {
                                                            <span> &middot; @b.BikeDescription</span>
                                                        }
                                                        @if (CanSeeCustomerDetails && !string.IsNullOrWhiteSpace(b.CustomerPhone))
                                                        {
                                                            <span> &middot; @b.CustomerPhone</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(b.Notes))
                                                    {
                                                        <div class="day-cal-booking__notes">@b.Notes</div>
                                                    }
                                                </div>
                                                <div class="day-cal-booking__actions">
                                                    @ActionButtons(b)
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ── PRICING TAB ────────────────────────────────────────────── -->
            @if (activeTab == "pricing" && IsAdmin)
            {
                <div class="staff-mgmt">
                    <div class="pricing-tab-header">
                        <h3>Service Prices</h3>
                        <button class="btn btn-primary" @onclick="SaveAllPrices">Save All</button>
                    </div>

                    @if (_priceSaveMessage != null)
                    {
                        <div class="admin-success">&#10003; @_priceSaveMessage</div>
                    }

                    @if (_priceAdjustments.Any())
                    {
                        var last = _priceAdjustments.First();
                        <div class="pricing-info-banner">
                            Last automatic increase: <strong>@last.AppliedAt.ToString("d MMMM yyyy")</strong>
                            &nbsp;·&nbsp; Rate applied: <strong>@((last.Rate * 100).ToString("0.##"))%</strong>
                            &nbsp;·&nbsp; Next increase: <strong>1 April @(last.Year + 1)</strong>
                        </div>
                    }

                    <div class="admin-table-wrapper">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>Category</th>
                                    <th>Duration</th>
                                    <th style="width:130px">Current Price</th>
                                    <th style="width:140px">New Price (£)</th>
                                    <th style="width:80px">Save</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sp in _servicePricings)
                                {
                                    var sid = sp.Id;
                                    <tr>
                                        <td><strong>@sp.Name</strong></td>
                                        <td class="text-muted-sm">@sp.Category</td>
                                        <td class="text-muted-sm">@sp.Duration</td>
                                        <td>
                                            @if (sp.IsQuoteOnly)
                                            {
                                                <span class="text-faint-sm">Quote only</span>
                                            }
                                            else
                                            {
                                                <span style="font-weight:700;color:var(--green)">£@sp.CurrentPrice</span>
                                            }
                                        </td>
                                        <td>
                                            @if (sp.IsQuoteOnly)
                                            {
                                                <span class="text-faint-sm">—</span>
                                            }
                                            else
                                            {
                                                <input class="form-control form-control--price"
                                                       type="number" min="0" step="1"
                                                       value="@_editPrices[sid]"
                                                       @oninput="e => { if (decimal.TryParse(e.Value?.ToString(), out var v)) _editPrices[sid] = v; }" />
                                            }
                                        </td>
                                        <td>
                                            @if (!sp.IsQuoteOnly)
                                            {
                                                <button class="action-btn action-btn--confirm"
                                                        @onclick="() => SavePrice(sid)">Save</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- ── STAFF MANAGEMENT TAB ────────────────────────────────── -->
            @if (activeTab == "staff" && IsAdmin)
            {
                <div class="staff-mgmt">

                    <!-- Add new staff form -->
                    <div class="staff-add-card">
                        <h3>Add Staff Member</h3>
                        @if (staffFormError != null)
                        {
                            <div class="booking-error" style="margin-bottom:.75rem">@staffFormError</div>
                        }
                        <div class="form-row">
                            <div class="form-group">
                                <label>Full Name</label>
                                <input class="form-control" @bind="newStaff.FullName" placeholder="Jane Smith" />
                            </div>
                            <div class="form-group">
                                <label>Email</label>
                                <input class="form-control" type="email" @bind="newStaff.Email" placeholder="jane@fixlosophy.com" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Password</label>
                                <input class="form-control" type="password" @bind="newStaffPassword" placeholder="Temporary password" />
                            </div>
                            <div class="form-group">
                                <label>Role</label>
                                <select class="form-control" @bind="newStaff.Role">
                                    <option value="@StaffRole.Worker">Worker</option>
                                    <option value="@StaffRole.Admin">Admin</option>
                                </select>
                            </div>
                        </div>
                        <button class="btn btn-primary" @onclick="AddStaff">Add Staff Member</button>
                    </div>

                    <!-- Staff list -->
                    <h3 class="admin-subheading">Current Staff</h3>
                    @if (staffRowError != null)
                    {
                        <div class="booking-error" style="margin-bottom:.75rem">@staffRowError</div>
                    }
                    <div class="admin-table-wrapper">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>View All Bookings</th>
                                    <th>Manage Bookings</th>
                                    <th>Customer Details</th>
                                    <th>Status</th>
                                    <th>Save</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in _allStaff)
                                {
                                    var m = member;
                                    var isCurrentUser = m.Id == loggedInStaff.Id;
                                    <tr>
                                        <td><strong>@m.FullName</strong> @if (isCurrentUser) { <span class="text-muted-sm">(you)</span> }</td>
                                        <td class="text-muted-sm">@m.Email</td>
                                        <td>
                                            <span class="status-badge status-badge--@(m.Role == StaffRole.Admin ? "confirmed" : "pending")">
                                                @m.Role
                                            </span>
                                        </td>
                                        @if (m.Role == StaffRole.Admin)
                                        {
                                            <td colspan="3" class="text-center text-muted-sm">Full access (Admin)</td>
                                        }
                                        else
                                        {
                                            <td class="text-center">
                                                <input type="checkbox" @bind="m.CanViewAllBookings" />
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox" @bind="m.CanManageBookings" />
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox" @bind="m.CanViewCustomerDetails" />
                                            </td>
                                        }
                                        <td>
                                            @if (!isCurrentUser)
                                            {
                                                <input type="checkbox" @bind="m.IsActive" title="Active" />
                                                <span class="text-muted-sm" style="margin-left:.3rem">Active</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted-sm">—</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="action-btn action-btn--confirm"
                                                    @onclick="() => SaveStaffMember(m)">Save</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private StaffMember? loggedInStaff;

    private string activeTab = "calendar";

    // Bookings
    private List<Booking> _allBookings = [];
    private string activeFilter = "All";
    private string searchTerm = "";
    private string? expandedId;
    private (int total, int today, int pending, int confirmed) stats;

    // BookingPhoto.Id -> signed URL, lazily filled the first time a booking with
    // photos is expanded (see ToggleExpand) rather than signing every booking's
    // photos up front on every load.
    private readonly Dictionary<string, string> _photoUrls = new();

    // Calendar tab
    private DateTime calDay = DateTime.Today;
    private List<Booking> _calDayBookings = [];
    private string? deleteConfirmId;

    // Staff management
    private List<StaffMember> _allStaff = [];
    private StaffMember newStaff = new();
    private string newStaffPassword = "";
    private string? staffFormError;
    private string? staffRowError;

    // Pricing management
    private List<ServicePricing> _servicePricings = [];
    private Dictionary<string, decimal> _editPrices = [];
    private List<PriceAdjustment> _priceAdjustments = [];
    private string? _priceSaveMessage;

    private static readonly string[] Filters =
        ["All", "Today", "Pending", "Confirmed", "In Progress", "Completed", "Cancelled"];

    private bool IsAdmin => loggedInStaff?.Role == StaffRole.Admin;
    private bool CanManage => IsAdmin || loggedInStaff?.CanManageBookings == true;
    private bool CanSeeCustomerDetails => IsAdmin || loggedInStaff?.CanViewCustomerDetails == true;

    // Reference, Customer, Service, Date & Time, Status — plus the two columns the
    // header row adds conditionally. Drives the expanded detail row's colspan, so
    // these conditions must stay in step with the <th> guards in the table header.
    private int BookingColumnCount =>
        5 + (IsAdmin ? 1 : 0) + (CanManage || CanSeeCustomerDetails ? 1 : 0);
    private List<Booking> TodayBookings =>
        FilteredBookings.Where(b => b.SlotDate.Date == DateTime.Today).ToList();

    private List<Booking> FilteredBookings
    {
        get
        {
            var all = _allBookings;

            all = activeFilter switch
            {
                "Today"       => all.Where(b => b.SlotDate.Date == DateTime.Today).ToList(),
                "Pending"     => all.Where(b => b.Status == BookingStatus.Pending).ToList(),
                "Confirmed"   => all.Where(b => b.Status == BookingStatus.Confirmed).ToList(),
                "In Progress" => all.Where(b => b.Status == BookingStatus.InProgress).ToList(),
                "Completed"   => all.Where(b => b.Status == BookingStatus.Completed).ToList(),
                "Cancelled"   => all.Where(b => b.Status == BookingStatus.Cancelled).ToList(),
                _             => all
            };

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var q = searchTerm.ToLower();
                all = all.Where(b =>
                    b.CustomerName.ToLower().Contains(q) ||
                    b.CustomerEmail.ToLower().Contains(q) ||
                    b.ServiceName.ToLower().Contains(q) ||
                    b.Reference.ToLower().Contains(q)).ToList();
            }

            return all;
        }
    }

    // True when a booking has any actionable controls for the current user —
    // used to decide whether to render the action area / Actions column at all.
    private bool RowHasActions(Booking b) =>
        CanManage || (CanSeeCustomerDetails && !string.IsNullOrWhiteSpace(b.CustomerPhone));

    // One shared action set, reused by the Bookings cards, the Bookings table and
    // the Calendar so every view offers the exact same lifecycle + contact + delete
    // controls. Each call site keeps its own wrapper element for layout/spacing.
    private RenderFragment<Booking> ActionButtons => booking => @<text>
        @if (CanManage && booking.Status == BookingStatus.Pending)
        {
            <button class="action-btn action-btn--confirm"
                    @onclick="() => UpdateStatus(booking.Id, BookingStatus.Confirmed)">Confirm</button>
        }
        @if (CanManage && booking.Status == BookingStatus.Confirmed)
        {
            <button class="action-btn action-btn--progress"
                    @onclick="() => UpdateStatus(booking.Id, BookingStatus.InProgress)">In Progress</button>
        }
        @if (CanManage && booking.Status == BookingStatus.InProgress)
        {
            <button class="action-btn action-btn--complete"
                    @onclick="() => UpdateStatus(booking.Id, BookingStatus.Completed)">Complete</button>
        }
        @if (CanSeeCustomerDetails && !string.IsNullOrWhiteSpace(booking.CustomerPhone))
        {
            <a class="action-btn action-btn--whatsapp" href="@WhatsAppHref(booking)" target="_blank" rel="noopener">WhatsApp</a>
            <a class="action-btn action-btn--call" href="@TelHref(booking.CustomerPhone)">Call</a>
        }
        @if (CanManage && booking.Status != BookingStatus.Cancelled && booking.Status != BookingStatus.Completed)
        {
            <button class="action-btn action-btn--cancel"
                    @onclick="() => UpdateStatus(booking.Id, BookingStatus.Cancelled)">Cancel</button>
        }
        @if (CanManage)
        {
            @if (deleteConfirmId == booking.Id)
            {
                <button class="action-btn action-btn--cancel" @onclick="() => DeleteBooking(booking.Id)">Confirm delete</button>
                <button class="action-btn action-btn--keep" @onclick="() => deleteConfirmId = null">Keep</button>
            }
            else
            {
                <button class="action-btn action-btn--delete" @onclick="() => deleteConfirmId = booking.Id">Delete</button>
            }
        }
    </text>;

    // The cookie carries the staff id; re-fetch the full record so permission and
    // role changes (or a deactivation) take effect on the next page load rather
    // than being frozen into the cookie's claims.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        var staffId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        loggedInStaff = staffId is null ? null : AuthService.GetStaffById(staffId);
        if (loggedInStaff is null)
        {
            // Authorized by cookie but the account is gone/deactivated — clear it.
            Nav.NavigateTo("/auth/logout", forceLoad: true);
            return;
        }

        LoadBookings();
        RefreshStats();
        LoadCalDay();  // Calendar is the default tab, so it needs data on first render.
        if (IsAdmin) _allStaff = AuthService.GetAllStaff();
    }

    private void Logout() => Nav.NavigateTo("/auth/logout", forceLoad: true);

    private void LoadBookings()
    {
        _allBookings = IsAdmin || loggedInStaff?.CanViewAllBookings == true
            ? BookingService.GetAllBookings()
            : BookingService.GetBookingsForStaff(loggedInStaff!.Id);
    }

    private void RefreshStats()
    {
        stats = IsAdmin || loggedInStaff?.CanViewAllBookings == true
            ? BookingService.GetStats()
            : BookingService.GetStatsForStaff(loggedInStaff!.Id);
    }

    private void SetFilter(string f) { activeFilter = f; expandedId = null; }
    private async Task ToggleExpand(string id)
    {
        var opening = expandedId != id;
        expandedId = opening ? id : null;
        if (!opening) return;

        var booking = FilteredBookings.FirstOrDefault(b => b.Id == id);
        if (booking is null) return;

        foreach (var photo in booking.Photos)
        {
            if (_photoUrls.ContainsKey(photo.Id)) continue;
            var url = await Storage.GetSignedPhotoUrlAsync(photo.StoragePath, TimeSpan.FromMinutes(15));
            if (url is not null) _photoUrls[photo.Id] = url;
        }
    }
    private void OnSearch(ChangeEventArgs e) => searchTerm = e.Value?.ToString() ?? "";

    private void UpdateStatus(string id, BookingStatus status)
    {
        if (!CanManage) return;  // server-side guard; don't rely on hidden buttons alone
        BookingService.UpdateStatus(id, status);
        deleteConfirmId = null;
        LoadBookings();
        RefreshStats();
        LoadCalDay();  // Keep the calendar view in sync when acted on from either tab.
    }

    private void AssignBooking(string bookingId, string? staffId)
    {
        if (!IsAdmin) return;  // assignment is admin-only
        BookingService.AssignStaff(bookingId, staffId);
        LoadBookings();
    }

    private void SetBookingsTab() => activeTab = "bookings";

    private void OpenCalendarTab()
    {
        activeTab = "calendar";
        SetCalDay(calDay);
    }

    private void SetCalDay(DateTime day)
    {
        calDay = day.Date;
        deleteConfirmId = null;
        LoadCalDay();
    }

    private void ChangeCalDay(int days) => SetCalDay(calDay.AddDays(days));

    private void OnCalDatePicked(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) SetCalDay(d);
    }

    private void LoadCalDay()
    {
        var dayBookings = BookingService.GetBookingsByDate(calDay);
        _calDayBookings = IsAdmin || loggedInStaff?.CanViewAllBookings == true
            ? dayBookings
            : dayBookings.Where(b => b.AssignedStaffId == loggedInStaff!.Id).ToList();
    }

    private async Task DeleteBooking(string id)
    {
        if (!CanManage) return;  // server-side guard
        await BookingService.DeleteBookingAsync(id);
        deleteConfirmId = null;
        LoadCalDay();
        LoadBookings();
        RefreshStats();
    }

    // wa.me needs the number in international format with no '+' or leading
    // zeros; bare national numbers (single leading 0) are assumed to be UK.
    private static string WhatsAppNumber(string phone)
    {
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("00")) return digits[2..];
        if (digits.StartsWith('0')) return "44" + digits[1..];
        return digits;
    }

    private string WhatsAppHref(Booking b)
    {
        var msg = $"Hi {b.CustomerName}, this is Fixlosophy about your booking {b.Reference} " +
                  $"({b.ServiceName}) on {b.SlotDate:dddd d MMMM} at {b.SlotTime}.";
        return $"https://wa.me/{WhatsAppNumber(b.CustomerPhone)}?text={Uri.EscapeDataString(msg)}";
    }

    private static string TelHref(string phone) =>
        $"tel:{new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray())}";

    private void OpenPricingTab()
    {
        if (!IsAdmin) return;  // pricing is admin-only
        activeTab = "pricing";
        _servicePricings = BookingService.GetServicePricings();
        _editPrices = _servicePricings.ToDictionary(s => s.Id, s => s.CurrentPrice);
        _priceAdjustments = BookingService.GetPriceAdjustments();
        _priceSaveMessage = null;
    }

    private void SavePrice(string id)
    {
        if (!IsAdmin) return;  // pricing is admin-only
        if (!_editPrices.TryGetValue(id, out var price) || price < 0) return;
        BookingService.UpdateServicePrice(id, Math.Round(price, 2));
        _priceSaveMessage = "Price updated.";
        _servicePricings = BookingService.GetServicePricings();
    }

    private void SaveAllPrices()
    {
        if (!IsAdmin) return;  // pricing is admin-only
        foreach (var (id, price) in _editPrices.Where(p => p.Value >= 0))
            BookingService.UpdateServicePrice(id, Math.Round(price, 2));
        _priceSaveMessage = "All prices saved.";
        _servicePricings = BookingService.GetServicePricings();
    }

    private void OpenStaffTab()
    {
        if (!IsAdmin) return;  // staff management is admin-only
        activeTab = "staff";
        _allStaff = AuthService.GetAllStaff();
    }

    private void AddStaff()
    {
        if (!IsAdmin) return;  // staff management is admin-only
        staffFormError = null;
        if (string.IsNullOrWhiteSpace(newStaff.FullName)) { staffFormError = "Name is required."; return; }
        if (!AuthService.IsValidEmail(newStaff.Email)) { staffFormError = "Please enter a valid email."; return; }
        if (AuthService.ValidatePassword(newStaffPassword) is { } pwError) { staffFormError = pwError; return; }

        newStaff.Email = AuthService.NormalizeEmail(newStaff.Email);
        newStaff.PasswordHash = AuthService.HashPassword(newStaffPassword);
        staffFormError = AuthService.SaveStaff(newStaff);
        if (staffFormError != null) return;

        _allStaff = AuthService.GetAllStaff();
        newStaff = new StaffMember();
        newStaffPassword = "";
    }

    private void SaveStaffMember(StaffMember member)
    {
        if (!IsAdmin) return;  // staff management is admin-only
        staffRowError = AuthService.SaveStaff(member);
        _allStaff = AuthService.GetAllStaff();
    }
}
