@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Worker")]
@implements IDisposable
@inject AuthService AuthService
@inject NotificationService Notifications
@inject NotificationHub NotificationHub
@inject EnquiryService Enquiries
@inject NavigationManager Nav

@*
    The dashboard shell: who's signed in, the notification bell, the tab bar — and
    nothing else. Each tab is its own component under Components/Admin.

    This file was 2,013 lines with all six tabs sharing one @code block of about forty
    fields, which is why a change to the pricing screen could break the calendar. The
    tabs never shared state; they shared a file.

    Switching tabs destroys the old component and creates the new one, so each tab
    loads its own data on init and can't show something stale. That replaced a set of
    hand-written cross-tab reloads — the bookings tab used to have to remember to
    refresh the calendar after a status change.
*@

<PageTitle>Admin – Fixlosophy Bookings</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@if (_context is not null)
{
    <div class="page-hero page-hero--sm page-hero--admin">
        <div class="container admin-hero-row">
            <div>
                <p class="section-eyebrow">@(_context.IsAdmin ? "Admin Dashboard" : "Staff Dashboard")</p>
                <h1>Booking Management</h1>
            </div>
            <div class="admin-header-actions">
                <span class="admin-header-actions__name">
                    @_context.Staff.FullName &nbsp;·&nbsp;
                    <span class="status-badge status-badge--@(_context.IsAdmin ? "confirmed" : "pending")">
                        @_context.Staff.Role
                    </span>
                </span>

                <div class="notif">
                    <button class="notif__bell @(bellOpen ? "notif__bell--open" : "")"
                            @onclick="ToggleBell"
                            aria-expanded="@bellOpen.ToString().ToLowerInvariant()"
                            aria-label="@($"Notifications, {unreadCount} unread")">
                        <Icon Name="bell" />
                        @if (unreadCount > 0)
                        {
                            <span class="notif__badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                        }
                    </button>

                    @if (bellOpen)
                    {
                        <div class="notif__panel">
                            <div class="notif__panel-head">
                                <strong>Notifications</strong>
                                @if (unreadCount > 0)
                                {
                                    <button class="notif__mark" @onclick="MarkAllRead">Mark all read</button>
                                }
                            </div>

                            @* Unread only by default, so "Mark all read" genuinely
                               clears the list. Read notifications aren't deleted —
                               they're behind the toggle below until the retention
                               purge removes them. *@
                            @if (_notifications.Count == 0)
                            {
                                <p class="notif__empty">
                                    @(showReadNotifications ? "Nothing in the last 30 days." : "All caught up.")
                                </p>
                            }
                            else
                            {
                                <ul class="notif__list">
                                    @foreach (var n in _notifications)
                                    {
                                        <li class="notif__item @(n.IsRead ? "" : "notif__item--unread")">
                                            <span class="notif__item-title">@n.Title</span>
                                            <span class="notif__item-body">@n.Body</span>
                                            <span class="notif__item-time">@RelativeTime(n.CreatedAt)</span>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="notif__panel-foot">
                                <button class="notif__mark" @onclick="ToggleShowRead">
                                    @(showReadNotifications ? "Show unread only" : "Show read too")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <button class="btn btn-outline" @onclick="Logout">Sign Out</button>
            </div>
        </div>
    </div>

    <section class="section admin-section">
        <div class="container">

            <!-- Tab bar -->
            <div class="admin-filter-scroll tab-bar-wrapper">
                <div class="admin-filter-tabs">
                    <button class="filter-tab @(activeTab == TabCalendar ? "active" : "")"
                            @onclick="() => SetTab(TabCalendar)">Calendar</button>
                    <button class="filter-tab @(activeTab == TabBookings ? "active" : "")"
                            @onclick="() => SetTab(TabBookings)">Bookings</button>
                    @* Gated on the same permission that governs seeing contact details
                       on a booking — reaching them through a customer list instead
                       shouldn't be a way around it. *@
                    @if (_context.CanSeeCustomerDetails)
                    {
                        <button class="filter-tab @(activeTab == TabCustomers ? "active" : "")"
                                @onclick="() => SetTab(TabCustomers)">Customers</button>
                        @* Same gate: an enquiry is a name, an email and a phone number
                           typed in by a member of the public. *@
                        <button class="filter-tab @(activeTab == TabEnquiries ? "active" : "")"
                                @onclick="() => SetTab(TabEnquiries)">
                            Enquiries
                            @if (unhandledEnquiries > 0)
                            {
                                <span class="filter-tab__count">@unhandledEnquiries</span>
                            }
                        </button>
                    }
                    @if (_context.IsAdmin)
                    {
                        <button class="filter-tab @(activeTab == TabAvailability ? "active" : "")"
                                @onclick="() => SetTab(TabAvailability)">Availability</button>
                        <button class="filter-tab @(activeTab == TabPricing ? "active" : "")"
                                @onclick="() => SetTab(TabPricing)">Pricing</button>
                        <button class="filter-tab @(activeTab == TabStaff ? "active" : "")"
                                @onclick="() => SetTab(TabStaff)">Staff Management</button>
                    }
                </div>
            </div>

            @* One cascading value rather than four parameters on every tab. The
               permission checks inside each tab duplicate the guards here on purpose:
               hiding a tab is not a permission check. *@
            <CascadingValue Value="_context" IsFixed="true">
                @switch (activeTab)
                {
                    case TabBookings:
                        <BookingsTab OnBookingsChanged="RefreshBadges" />
                        break;

                    case TabCalendar:
                        <CalendarTab OnBookingsChanged="RefreshBadges" />
                        break;

                    case TabCustomers when _context.CanSeeCustomerDetails:
                        <CustomersTab />
                        break;

                    case TabEnquiries when _context.CanSeeCustomerDetails:
                        <EnquiriesTab OnChanged="RefreshBadges" />
                        break;

                    case TabAvailability when _context.IsAdmin:
                        <AvailabilityTab />
                        break;

                    case TabPricing when _context.IsAdmin:
                        <PricingTab />
                        break;

                    case TabStaff when _context.IsAdmin:
                        <StaffTab />
                        break;
                }
            </CascadingValue>

        </div>
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const string TabCalendar     = "calendar";
    private const string TabBookings     = "bookings";
    private const string TabCustomers    = "customers";
    private const string TabEnquiries    = "enquiries";
    private const string TabAvailability = "availability";
    private const string TabPricing      = "pricing";
    private const string TabStaff        = "staff";

    private AdminContext? _context;
    private string activeTab = TabCalendar;

    private List<Notification> _notifications = [];
    private int unreadCount;
    private int unhandledEnquiries;
    private bool bellOpen;

    // The panel lists unread by default, so marking all read empties it. Read ones
    // stay available behind the toggle until the retention purge removes them.
    private bool showReadNotifications;

    // The cookie carries the staff id; re-fetch the full record so permission and
    // role changes (or a deactivation) take effect on the next page load rather
    // than being frozen into the cookie's claims.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        var staffId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        var staff = staffId is null ? null : AuthService.GetStaffById(staffId);
        if (staff is null)
        {
            // Authorized by cookie but the account is gone/deactivated — clear it.
            Nav.NavigateTo("/auth/logout", forceLoad: true);
            return;
        }

        _context = new AdminContext(staff);

        RefreshBadges();
        LoadNotifications();
        NotificationHub.Raised += OnNotificationRaised;
    }

    private void SetTab(string tab) => activeTab = tab;

    /// <summary>
    /// Re-reads the two counts the shell itself shows. Called by the tabs after
    /// anything that could move them.
    /// </summary>
    /// <remarks>
    /// A count query rather than a list: the enquiries badge is wanted on every load,
    /// including by someone who never opens that tab. Loading only on open meant the
    /// badge read zero until you went looking, which is the wrong way round.
    /// </remarks>
    private void RefreshBadges()
    {
        if (_context is null) return;
        if (_context.CanSeeCustomerDetails) unhandledEnquiries = Enquiries.CountUnhandled();
        unreadCount = Notifications.UnreadCount(_context.Staff.Id);
    }

    // ── Notifications ────────────────────────────────────────────────────────
    // The hub raises on whichever thread created the notification — a different
    // circuit's thread, usually — so everything here marshals onto this component's
    // dispatcher before touching state or re-rendering.
    private void OnNotificationRaised(Notification notification)
    {
        // Broadcasts (null target) reach everyone; a targeted one only its recipient.
        if (notification.TargetStaffId is not null && notification.TargetStaffId != _context?.Staff.Id)
            return;

        _ = InvokeAsync(() =>
        {
            LoadNotifications();
            StateHasChanged();
        });
    }

    private void LoadNotifications()
    {
        if (_context is null) return;
        _notifications = Notifications.GetRecent(_context.Staff.Id, unreadOnly: !showReadNotifications);
        unreadCount = Notifications.UnreadCount(_context.Staff.Id);
    }

    private void ToggleBell()
    {
        bellOpen = !bellOpen;
        if (bellOpen) LoadNotifications();
    }

    private void ToggleShowRead()
    {
        showReadNotifications = !showReadNotifications;
        LoadNotifications();
    }

    private void MarkAllRead()
    {
        Notifications.MarkAllRead(_context!.Staff.Id);
        LoadNotifications();
    }

    // Short relative time — "4m", "2h", "3d" — so the panel stays scannable.
    private static string RelativeTime(DateTime when)
    {
        var elapsed = ShopClock.Now - when;
        if (elapsed < TimeSpan.FromMinutes(1)) return "just now";
        if (elapsed < TimeSpan.FromHours(1))   return $"{(int)elapsed.TotalMinutes}m";
        if (elapsed < TimeSpan.FromDays(1))    return $"{(int)elapsed.TotalHours}h";
        if (elapsed < TimeSpan.FromDays(7))    return $"{(int)elapsed.TotalDays}d";
        return when.ToString("d MMM", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    }

    private void Logout() => Nav.NavigateTo("/auth/logout", forceLoad: true);

    // Unsubscribing matters: the hub is a singleton, so a leaked handler would keep
    // this circuit's component alive for the life of the process.
    public void Dispose() => NotificationHub.Raised -= OnNotificationRaised;
}
