@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Worker")]
@implements IDisposable
@inject BookingService BookingService
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IStorageService Storage
@inject NotificationService Notifications
@inject NotificationHub NotificationHub
@inject CustomerService Customers
@inject IEmailSender EmailSender
@inject ILogger<Admin> Logger

<PageTitle>Admin – Fixlosophy Bookings</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@if (loggedInStaff != null)
{
    <div class="page-hero page-hero--sm page-hero--admin">
        <div class="container admin-hero-row">
            <div>
                <p class="section-eyebrow">@(IsAdmin ? "Admin Dashboard" : "Staff Dashboard")</p>
                <h1>Booking Management</h1>
            </div>
            <div class="admin-header-actions">
                <span class="admin-header-actions__name">
                    @loggedInStaff.FullName &nbsp;·&nbsp;
                    <span class="status-badge status-badge--@(IsAdmin ? "confirmed" : "pending")">
                        @loggedInStaff.Role
                    </span>
                </span>

                <div class="notif">
                    <button class="notif__bell @(bellOpen ? "notif__bell--open" : "")"
                            @onclick="ToggleBell"
                            aria-expanded="@bellOpen.ToString().ToLowerInvariant()"
                            aria-label="@($"Notifications, {unreadCount} unread")">
                        <Icon Name="bell" />
                        @if (unreadCount > 0)
                        {
                            <span class="notif__badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                        }
                    </button>

                    @if (bellOpen)
                    {
                        <div class="notif__panel">
                            <div class="notif__panel-head">
                                <strong>Notifications</strong>
                                @if (unreadCount > 0)
                                {
                                    <button class="notif__mark" @onclick="MarkAllRead">Mark all read</button>
                                }
                            </div>

                            @* Unread only by default, so "Mark all read" genuinely
                               clears the list. Read notifications aren't deleted —
                               they're behind the toggle below until the retention
                               purge removes them. *@
                            @if (_notifications.Count == 0)
                            {
                                <p class="notif__empty">
                                    @(showReadNotifications ? "Nothing in the last 30 days." : "All caught up.")
                                </p>
                            }
                            else
                            {
                                <ul class="notif__list">
                                    @foreach (var n in _notifications)
                                    {
                                        <li class="notif__item @(n.IsRead ? "" : "notif__item--unread")">
                                            <span class="notif__item-title">@n.Title</span>
                                            <span class="notif__item-body">@n.Body</span>
                                            <span class="notif__item-time">@RelativeTime(n.CreatedAt)</span>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="notif__panel-foot">
                                <button class="notif__mark" @onclick="ToggleShowRead">
                                    @(showReadNotifications ? "Show unread only" : "Show read too")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <button class="btn btn-outline" @onclick="Logout">Sign Out</button>
            </div>
        </div>
    </div>

    <section class="section admin-section">
        <div class="container">

            <!-- Tab bar -->
            <div class="admin-filter-scroll tab-bar-wrapper">
                <div class="admin-filter-tabs">
                    <button class="filter-tab @(activeTab == "calendar" ? "active" : "")"
                            @onclick="OpenCalendarTab">Calendar</button>
                    <button class="filter-tab @(activeTab == "bookings" ? "active" : "")"
                            @onclick="SetBookingsTab">Bookings</button>
                    @* Gated on the same permission that governs seeing contact details
                       on a booking — reaching them through a customer list instead
                       shouldn't be a way around it. *@
                    @if (CanSeeCustomerDetails)
                    {
                        <button class="filter-tab @(activeTab == "customers" ? "active" : "")"
                                @onclick="OpenCustomersTab">Customers</button>
                    }
                    @if (IsAdmin)
                    {
                        <button class="filter-tab @(activeTab == "pricing" ? "active" : "")"
                                @onclick="OpenPricingTab">Pricing</button>
                        <button class="filter-tab @(activeTab == "staff" ? "active" : "")"
                                @onclick="OpenStaffTab">Staff Management</button>
                    }
                </div>
            </div>

            <!-- ── BOOKINGS TAB ─────────────────────────────────────────── -->
            @if (activeTab == "bookings")
            {
                <!-- Stats -->
                <div class="admin-stats">
                    <div class="admin-stat">
                        <div class="admin-stat__number">@stats.total</div>
                        <div class="admin-stat__label">@(IsAdmin || loggedInStaff.CanViewAllBookings ? "Total" : "Assigned")</div>
                    </div>
                    <div class="admin-stat admin-stat--highlight">
                        <div class="admin-stat__number">@stats.today</div>
                        <div class="admin-stat__label">Today</div>
                    </div>
                    <div class="admin-stat">
                        <div class="admin-stat__number">@stats.pending</div>
                        <div class="admin-stat__label">Pending</div>
                    </div>
                    <div class="admin-stat">
                        <div class="admin-stat__number">@stats.confirmed</div>
                        <div class="admin-stat__label">Confirmed</div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="admin-filters">
                    <div class="admin-filter-scroll">
                        <div class="admin-filter-tabs">
                            @foreach (var f in Filters)
                            {
                                <button class="filter-tab @(activeFilter == f ? "active" : "")"
                                        @onclick="() => SetFilter(f)">@f</button>
                            }
                        </div>
                    </div>
                    <div class="admin-search">
                        <label class="sr-only" for="booking-search">Search bookings</label>
                        <input id="booking-search" class="form-control" type="text"
                               value="@searchTerm" @oninput="OnSearch"
                               placeholder="Search name, ref, service…" />
                    </div>
                    <div class="admin-sort">
                        <label class="sr-only" for="booking-sort">Sort bookings</label>
                        <select id="booking-sort" class="form-control"
                                value="@sortMode" @onchange="SetSort">
                            @foreach (var opt in BookingService.SortOptions)
                            {
                                <option value="@opt">@BookingService.SortLabel(opt)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (TodayBookings.Any() && activeFilter == "All")
                {
                    <div class="today-schedule">
                        <h3><Icon Name="clock" /> Today's Schedule</h3>
                        <div class="today-slots">
                            @foreach (var b in TodayBookings.OrderBy(x => x.SlotTime))
                            {
                                <div class="today-slot">
                                    <span class="today-slot__time">@b.SlotTime</span>
                                    <span class="today-slot__name">@b.CustomerName</span>
                                    <span class="today-slot__service">@b.ServiceName</span>
                                    <span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* A search that matches nothing used to remove the cards, the pager AND
                   the whole table, column headers included, leaving one line of text
                   where the list had been. The table is the thing being searched, so it
                   stays put and says it found nothing. *@
                <!-- MOBILE: Card list -->
                <div class="admin-cards">
                    @if (!FilteredBookings.Any())
                    {
                        <div class="admin-empty"><p>@BookingsEmptyMessage</p></div>
                    }
                    @foreach (var booking in FilteredBookings)
                    {
                        var b = booking;
                        var isOpen = expandedId == b.Id;
                        <div class="admin-card @(isOpen ? "admin-card--open" : "")" @onclick="() => ToggleExpand(b.Id)">
                            <div class="admin-card__header">
                                <span class="ref-badge">@b.Reference</span>
                                <div class="admin-card__header-right">
                                    <span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span>
                                    <span class="admin-card__chevron @(isOpen ? "open" : "")"><Icon Name="chevron-right" /></span>
                                </div>
                            </div>
                            <div class="admin-card__name">@b.CustomerName</div>
                            <div class="admin-card__meta">
                                <span>@b.ServiceName</span>
                                <span>@b.SlotDate.ToString("d MMM") &middot; @b.SlotTime</span>
                            </div>

                            @if (isOpen)
                            {
                                <div class="admin-card__detail">
                                    @if (CanSeeCustomerDetails)
                                    {
                                        <div class="admin-card__detail-row"><span>Email</span><span>@b.CustomerEmail</span></div>
                                        @if (!string.IsNullOrWhiteSpace(b.CustomerPhone))
                                        {
                                            <div class="admin-card__detail-row"><span>Phone</span><span>@b.CustomerPhone</span></div>
                                        }
                                    }
                                    @if (!string.IsNullOrWhiteSpace(b.BikeDescription))
                                    {
                                        <div class="admin-card__detail-row"><span>Bike</span><span>@b.BikeDescription</span></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(b.Notes))
                                    {
                                        <div class="admin-card__detail-row"><span>Notes</span><span>@b.Notes</span></div>
                                    }
                                    @* Staff notes on this job. Shown here as well as on the
                                       customer's page because a guest booking has no customer
                                       record — without this, a note written against one would
                                       be stored and then invisible. *@
                                    @if (_bookingNotes.TryGetValue(b.Id, out var jobNotes) && jobNotes.Count > 0)
                                    {
                                        <div class="admin-card__detail-row">
                                            <span>Job notes</span>
                                            <span class="booking-notes">
                                                @foreach (var note in jobNotes)
                                                {
                                                    <span class="booking-note @(note.VisibleToCustomer ? "booking-note--shared" : "")">
                                                        @note.Body
                                                        <span class="text-faint-sm">
                                                            @(note.VisibleToCustomer ? "shared with customer" : "internal")
                                                            &middot; @note.CreatedAt.ToString("d MMM")
                                                        </span>
                                                    </span>
                                                }
                                            </span>
                                        </div>
                                    }
                                    @if (b.Photos.Count > 0)
                                    {
                                        <div class="admin-card__detail-row">
                                            <span>Photos</span>
                                            <div class="admin-photo-thumbs">
                                                @foreach (var photo in b.Photos)
                                                {
                                                    @if (_photoUrls.TryGetValue(photo.Id, out var url))
                                                    {
                                                        <a href="@url" target="_blank" rel="noopener noreferrer" @onclick:stopPropagation="true">
                                                            <img src="@url" class="admin-photo-thumb" alt="Issue photo" />
                                                        </a>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                    <div class="admin-card__detail-row">
                                        <span>Price</span><span>@(b.ServicePrice > 0 ? $"From £{b.ServicePrice}" : "Quote")</span>
                                    </div>
                                    <div class="admin-card__detail-row">
                                        <span>Booked</span><span>@b.CreatedAt.ToString("d MMM, HH:mm")</span>
                                    </div>
                                    @if (IsAdmin)
                                    {
                                        <div class="admin-card__detail-row">
                                            <span>Assign to</span>
                                            <select class="form-control form-control--compact"
                                                    value="@b.AssignedStaffId"
                                                    @onchange="e => AssignBooking(b.Id, e.Value?.ToString())"
                                                    @onclick:stopPropagation="true">
                                                <option value="">— Unassigned —</option>
                                                @foreach (var s in _allStaff.Where(x => x.IsActive))
                                                {
                                                    <option value="@s.Id">@s.FullName</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                    @DangerZone(b)
                                </div>
                            }

                            @if (RowHasActions(b))
                            {
                                <div class="admin-card__actions" @onclick:stopPropagation="true">
                                    @ActionButtons(b)
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Explicit prev/next rather than infinite scroll: on a phone,
                   infinite scroll makes anything below the list unreachable. *@
                @if (TotalPages > 1)
                {
                    <nav class="pager" aria-label="Booking pages">
                        <button class="btn btn-outline pager__btn"
                                disabled="@(_page == 0)"
                                @onclick="() => GoToPage(_page - 1)">
                            <Icon Name="arrow-left" /> Previous
                        </button>
                        <span class="pager__status" aria-live="polite">
                            Page @(_page + 1) of @TotalPages &middot; @_totalMatches booking@(_totalMatches == 1 ? "" : "s")
                        </span>
                        <button class="btn btn-outline pager__btn"
                                disabled="@(_page >= TotalPages - 1)"
                                @onclick="() => GoToPage(_page + 1)">
                            Next <Icon Name="arrow-right" />
                        </button>
                    </nav>
                }

                <!-- DESKTOP: Table -->
                <div class="admin-table-wrapper admin-table-wrapper--desktop-only">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Customer</th>
                                <th>Service</th>
                                <th>Date &amp; Time</th>
                                <th>Status</th>
                                @if (IsAdmin) { <th>Assigned To</th> }
                                @if (CanManage || CanSeeCustomerDetails) { <th class="col-actions">Actions</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredBookings.Any())
                            {
                                <tr class="admin-table__empty-row">
                                    <td colspan="@BookingColumnCount">@BookingsEmptyMessage</td>
                                </tr>
                            }
                            @foreach (var booking in FilteredBookings)
                            {
                                var b = booking;
                                <tr class="@(expandedId == b.Id ? "row-expanded" : "")" @onclick="() => ToggleExpand(b.Id)">
                                    <td><span class="ref-badge">@b.Reference</span></td>
                                    <td>
                                        <div class="customer-cell">
                                            <strong>@b.CustomerName</strong>
                                            @if (CanSeeCustomerDetails)
                                            {
                                                <span>@b.CustomerEmail</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="service-cell">
                                            <strong>@b.ServiceName</strong>
                                            <span>@(b.ServicePrice > 0 ? $"£{b.ServicePrice}" : "Quote")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="date-cell">
                                            <strong>@b.SlotDate.ToString("d MMM yyyy")</strong>
                                            <span>@b.SlotTime</span>
                                        </div>
                                    </td>
                                    <td><span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span></td>
                                    @if (IsAdmin)
                                    {
                                        <td @onclick:stopPropagation="true">
                                            <select class="form-control form-control--compact form-control--assign"
                                                    value="@b.AssignedStaffId"
                                                    @onchange="e => AssignBooking(b.Id, e.Value?.ToString())">
                                                <option value="">— Unassigned —</option>
                                                @foreach (var s in _allStaff.Where(x => x.IsActive))
                                                {
                                                    <option value="@s.Id">@s.FullName</option>
                                                }
                                            </select>
                                        </td>
                                    }
                                    @if (CanManage || CanSeeCustomerDetails)
                                    {
                                        <td @onclick:stopPropagation="true">
                                            <div class="action-buttons">
                                                @ActionButtons(b)
                                            </div>
                                        </td>
                                    }
                                </tr>
                                @if (expandedId == b.Id && CanSeeCustomerDetails)
                                {
                                    <tr class="row-detail">
                                        <td colspan="@BookingColumnCount">
                                            <div class="booking-detail">
                                                <div class="booking-detail__grid">
                                                    <div><strong>Phone</strong><span>@(string.IsNullOrWhiteSpace(b.CustomerPhone) ? "—" : b.CustomerPhone)</span></div>
                                                    <div><strong>Bike</strong><span>@(string.IsNullOrWhiteSpace(b.BikeDescription) ? "—" : b.BikeDescription)</span></div>
                                                    <div><strong>Booked</strong><span>@b.CreatedAt.ToString("d MMM yyyy, HH:mm")</span></div>
                                                    <div><strong>Notes</strong><span>@(string.IsNullOrWhiteSpace(b.Notes) ? "—" : b.Notes)</span></div>
                                                    <div>
                                                        <strong>Job notes</strong>
                                                        @if (_bookingNotes.TryGetValue(b.Id, out var rowNotes) && rowNotes.Count > 0)
                                                        {
                                                            <span class="booking-notes">
                                                                @foreach (var note in rowNotes)
                                                                {
                                                                    <span class="booking-note @(note.VisibleToCustomer ? "booking-note--shared" : "")">
                                                                        @note.Body
                                                                        <span class="text-faint-sm">
                                                                            @(note.VisibleToCustomer ? "shared with customer" : "internal")
                                                                            &middot; @note.CreatedAt.ToString("d MMM")
                                                                        </span>
                                                                    </span>
                                                                }
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span>—</span>
                                                        }
                                                    </div>
                                                </div>
                                                @if (b.Photos.Count > 0)
                                                {
                                                    <div class="booking-detail__photos">
                                                        <strong>Photos</strong>
                                                        <div class="admin-photo-thumbs">
                                                            @foreach (var photo in b.Photos)
                                                            {
                                                                @if (_photoUrls.TryGetValue(photo.Id, out var url))
                                                                {
                                                                    <a href="@url" target="_blank" rel="noopener noreferrer">
                                                                        <img src="@url" class="admin-photo-thumb" alt="Issue photo" />
                                                                    </a>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                @DangerZone(b)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- ── CALENDAR TAB ──────────────────────────────────────────── -->
            @if (activeTab == "calendar")
            {
                <div class="day-cal">
                    @* Two explicit groups rather than one wrapping flex row. Previously
                       all five controls shared a row that wrapped wherever it ran out
                       of space, which on a phone put "previous day" on one line and
                       "next day" on the next — the two arrows split apart, which reads
                       as broken. Now the arrows always flank the date, and the jump
                       controls sit on their own row beneath. *@
                    <div class="day-cal__nav">
                        <div class="day-cal__nav-main">
                            <button class="cal-nav__btn" @onclick="() => ChangeCalDay(-1)" aria-label="Previous day"><Icon Name="chevron-left" /></button>
                            @* Two lengths of the same date, one shown per breakpoint.
                               The full form wraps to two lines on a phone and pushes
                               the arrows apart; the short form keeps the whole header
                               to a single line. The year is redundant on mobile —
                               the picker directly below it spells the date out in
                               full. `display: none` also drops the hidden one from
                               the accessibility tree, so it isn't announced twice. *@
                            <div class="day-cal__title">
                                <strong class="day-cal__date day-cal__date--full">@calDay.ToString("dddd, d MMMM yyyy")</strong>
                                <strong class="day-cal__date day-cal__date--short">@calDay.ToString("ddd d MMM")</strong>
                                @if (calDay.Date == ShopClock.Today)
                                {
                                    <span class="status-badge status-badge--confirmed">Today</span>
                                }
                            </div>
                            <button class="cal-nav__btn" @onclick="() => ChangeCalDay(1)" aria-label="Next day"><Icon Name="chevron-right" /></button>
                        </div>

                        <div class="day-cal__nav-tools">
                            <label class="sr-only" for="day-cal-date">Jump to date</label>
                            <input id="day-cal-date" type="date" class="form-control day-cal__picker"
                                   value="@calDay.ToString("yyyy-MM-dd")" @onchange="OnCalDatePicked" />
                            @if (calDay.Date != ShopClock.Today)
                            {
                                <button class="btn btn-outline" @onclick="() => SetCalDay(ShopClock.Today)">Today</button>
                            }
                        </div>
                    </div>

                    <div class="day-cal__summary">
                        <span><strong>@_calDayBookings.Count</strong> booking@(_calDayBookings.Count == 1 ? "" : "s")</span>
                        @if (_calDayBookings.Any(b => b.Status == BookingStatus.Pending))
                        {
                            <span class="status-badge status-badge--pending">@_calDayBookings.Count(b => b.Status == BookingStatus.Pending) pending</span>
                        }
                        @if (calDay.DayOfWeek == DayOfWeek.Sunday)
                        {
                            <span class="day-cal__closed">Sunday hours — 11am to 5pm</span>
                        }
                    </div>

                    <div class="day-cal__slots">
                        @foreach (var slot in BookingService.SlotsFor(calDay))
                        {
                            var slotBookings = _calDayBookings.Where(b => b.SlotTime == slot).ToList();
                            <div class="day-cal-slot @(slotBookings.Count == 0 ? "day-cal-slot--free" : "")">
                                <div class="day-cal-slot__time">@slot</div>
                                <div class="day-cal-slot__content">
                                    @if (slotBookings.Count == 0)
                                    {
                                        <span class="day-cal-slot__free">Free</span>
                                    }
                                    else
                                    {
                                        @foreach (var booking in slotBookings)
                                        {
                                            var b = booking;
                                            <div class="day-cal-booking @(b.Status == BookingStatus.Cancelled ? "day-cal-booking--cancelled" : "")">
                                                <div class="day-cal-booking__info">
                                                    <div class="day-cal-booking__head">
                                                        <strong>@b.CustomerName</strong>
                                                        <span class="ref-badge">@b.Reference</span>
                                                        <span class="status-badge status-badge--@b.Status.ToString().ToLower()">@b.Status</span>
                                                    </div>
                                                    <div class="day-cal-booking__meta">
                                                        <span>@b.ServiceName</span>
                                                        @if (!string.IsNullOrWhiteSpace(b.BikeDescription))
                                                        {
                                                            <span> &middot; @b.BikeDescription</span>
                                                        }
                                                        @if (CanSeeCustomerDetails && !string.IsNullOrWhiteSpace(b.CustomerPhone))
                                                        {
                                                            <span> &middot; @b.CustomerPhone</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(b.Notes))
                                                    {
                                                        <div class="day-cal-booking__notes">@b.Notes</div>
                                                    }
                                                </div>
                                                @if (RowHasActions(b))
                                                {
                                                    <div class="day-cal-booking__actions">
                                                        @ActionButtons(b)
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ── PRICING TAB ────────────────────────────────────────────── -->
            @if (activeTab == "pricing" && IsAdmin)
            {
                <div class="staff-mgmt">
                    <div class="pricing-tab-header">
                        <h3>Service Prices</h3>
                        <button class="btn btn-primary" @onclick="SaveAllPrices">Save All</button>
                    </div>

                    @if (_priceSaveMessage != null)
                    {
                        <div class="admin-success"><Icon Name="check" /> @_priceSaveMessage</div>
                    }

                    @if (_priceAdjustments.Any())
                    {
                        var last = _priceAdjustments.First();
                        <div class="pricing-info-banner">
                            Last automatic increase: <strong>@last.AppliedAt.ToString("d MMMM yyyy")</strong>
                            &nbsp;·&nbsp; Rate applied: <strong>@((last.Rate * 100).ToString("0.##"))%</strong>
                            &nbsp;·&nbsp; Next increase: <strong>1 April @(last.Year + 1)</strong>
                        </div>
                    }

                    <!-- MOBILE: one card per service. The table below is hidden under
                         768px, and without these this tab was blank on every phone.
                         The --sticky-actions modifier reserves room at the bottom for
                         the floating Save All bar, which otherwise sits permanently on
                         top of the last service's own Save button. -->
                    <div class="admin-mobile-cards admin-mobile-cards--sticky-actions">
                        @foreach (var sp in _servicePricings)
                        {
                            var sid = sp.Id;
                            <div class="admin-edit-card">
                                <div class="admin-edit-card__title">@sp.Name</div>
                                <div class="admin-edit-card__meta">@sp.Category &middot; @sp.Duration</div>

                                @if (sp.IsQuoteOnly)
                                {
                                    <div class="admin-edit-card__field">
                                        <span>Price</span>
                                        <span class="text-faint-sm">Quote only</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="admin-edit-card__field">
                                        <span>Current</span>
                                        <strong class="price-current">£@sp.CurrentPrice</strong>
                                    </div>
                                    <div class="admin-edit-card__field">
                                        <label for="price-m-@sid">New price (£)</label>
                                        <input id="price-m-@sid" class="form-control form-control--price"
                                               type="number" min="0" step="1" inputmode="decimal"
                                               value="@_editPrices[sid]"
                                               @oninput="e => { if (decimal.TryParse(e.Value?.ToString(), out var v)) _editPrices[sid] = v; }" />
                                    </div>
                                    <div class="admin-edit-card__actions">
                                        <button class="btn btn-outline" @onclick="() => SavePrice(sid)">Save</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="pricing-sticky-actions">
                        <button class="btn btn-primary" @onclick="SaveAllPrices">Save All Prices</button>
                    </div>

                    <div class="admin-table-wrapper admin-table-wrapper--desktop-only">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>Category</th>
                                    <th>Duration</th>
                                    <th class="col-price">Current Price</th>
                                    <th class="col-price-input">New Price (£)</th>
                                    <th class="col-save">Save</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sp in _servicePricings)
                                {
                                    var sid = sp.Id;
                                    <tr>
                                        <td><strong>@sp.Name</strong></td>
                                        <td class="text-muted-sm">@sp.Category</td>
                                        <td class="text-muted-sm">@sp.Duration</td>
                                        <td>
                                            @if (sp.IsQuoteOnly)
                                            {
                                                <span class="text-faint-sm">Quote only</span>
                                            }
                                            else
                                            {
                                                <span class="price-current">£@sp.CurrentPrice</span>
                                            }
                                        </td>
                                        <td>
                                            @if (sp.IsQuoteOnly)
                                            {
                                                <span class="text-faint-sm">—</span>
                                            }
                                            else
                                            {
                                                <input class="form-control form-control--price"
                                                       type="number" min="0" step="1"
                                                       value="@_editPrices[sid]"
                                                       @oninput="e => { if (decimal.TryParse(e.Value?.ToString(), out var v)) _editPrices[sid] = v; }" />
                                            }
                                        </td>
                                        <td>
                                            @if (!sp.IsQuoteOnly)
                                            {
                                                <button class="action-btn action-btn--primary"
                                                        @onclick="() => SavePrice(sid)">Save</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- ── STAFF MANAGEMENT TAB ────────────────────────────────── -->
            <!-- ── CUSTOMERS TAB ─────────────────────────────────────────── -->
            @if (activeTab == "customers" && CanSeeCustomerDetails)
            {
                @if (_importingCustomers)
                {
                    <CustomerImportPanel OnBack="CloseImport" OnImported="LoadCustomers" />
                }
                else if (_selectedCustomer is null)
                {
                    <div class="admin-filters">
                        <div class="admin-search admin-search--wide">
                            <label class="sr-only" for="customer-search">Search customers</label>
                            <input id="customer-search" class="form-control" type="text"
                                   value="@customerSearch" @oninput="OnCustomerSearch"
                                   placeholder="Search name, email or phone…" />
                        </div>
                        @* Bulk-importing personal data is an owner's job, not a
                           mechanic's — IsAdmin rather than the tab's own
                           CanSeeCustomerDetails. *@
                        @if (IsAdmin)
                        {
                            <button class="btn btn-outline" @onclick="OpenImport">Import customers</button>
                        }
                    </div>

                    @* Same as the bookings list: the table being searched stays on the
                       page and reports the empty result itself. *@
                    <div class="admin-mobile-cards">
                        @if (_customers.Count == 0)
                        {
                            <div class="admin-empty"><p>@CustomersEmptyMessage</p></div>
                        }
                        @foreach (var c in _customers)
                        {
                            var cust = c;
                            <button type="button" class="admin-edit-card customer-card"
                                    @onclick="() => OpenCustomer(cust.Id)">
                                <span class="admin-edit-card__title">@cust.FullName</span>
                                <span class="admin-edit-card__meta">@cust.Email</span>
                                <span class="customer-card__stats">
                                    <span>@cust.BookingCount booking@(cust.BookingCount == 1 ? "" : "s")</span>
                                    <span>@(cust.LastVisit is { } lv ? $"Last: {lv:d MMM yyyy}" : "No visits yet")</span>
                                </span>
                            </button>
                        }
                    </div>

                    <div class="admin-table-wrapper admin-table-wrapper--desktop-only">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Bookings</th>
                                    <th>Last visit</th>
                                    <th>Member since</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_customers.Count == 0)
                                {
                                    <tr class="admin-table__empty-row">
                                        <td colspan="6">@CustomersEmptyMessage</td>
                                    </tr>
                                }
                                @foreach (var c in _customers)
                                {
                                    var cust = c;
                                    <tr @onclick="() => OpenCustomer(cust.Id)">
                                        <td><strong>@cust.FullName</strong></td>
                                        <td class="text-muted-sm">@cust.Email</td>
                                        <td class="text-muted-sm">@cust.Phone</td>
                                        <td>@cust.BookingCount</td>
                                        <td class="text-muted-sm">@(cust.LastVisit is { } lv ? lv.ToString("d MMM yyyy") : "—")</td>
                                        <td class="text-muted-sm">@cust.MemberSince.ToString("d MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (CustomerTotalPages > 1)
                    {
                        <nav class="pager" aria-label="Customer pages">
                            <button class="btn btn-outline pager__btn" disabled="@(_customerPage == 0)"
                                    @onclick="() => GoToCustomerPage(_customerPage - 1)">
                                <Icon Name="arrow-left" /> Previous
                            </button>
                            <span class="pager__status" aria-live="polite">
                                Page @(_customerPage + 1) of @CustomerTotalPages &middot; @_customerTotal customer@(_customerTotal == 1 ? "" : "s")
                            </span>
                            <button class="btn btn-outline pager__btn" disabled="@(_customerPage >= CustomerTotalPages - 1)"
                                    @onclick="() => GoToCustomerPage(_customerPage + 1)">
                                Next <Icon Name="arrow-right" />
                            </button>
                        </nav>
                    }
                }
                else
                {
                    <CustomerDetailPanel Detail="_selectedCustomer"
                                         CanManage="CanManage"
                                         OnBack="CloseCustomer"
                                         OnAddNote="AddCustomerNote"
                                         OnDeleteNote="DeleteCustomerNote" />
                }
            }

            @if (activeTab == "staff" && IsAdmin)
            {
                <div class="staff-mgmt">

                    <!-- Add new staff form -->
                    <div class="staff-add-card">
                        <h3>Add Staff Member</h3>
                        @if (staffFormError != null)
                        {
                            <div class="booking-error admin-inline-error">@staffFormError</div>
                        }
                        <div class="form-row">
                            <div class="form-group">
                                <label for="admin-full-name">Full Name</label>
                                <input id="admin-full-name" class="form-control" @bind="newStaff.FullName" placeholder="Jane Smith" />
                            </div>
                            <div class="form-group">
                                <label for="admin-email">Email</label>
                                <input id="admin-email" class="form-control" type="email"
                                       autocomplete="email" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false"
                                       @bind="newStaff.Email" placeholder="jane@fixlosophy.com" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="admin-password">Password</label>
                                <input id="admin-password" class="form-control" type="password" @bind="newStaffPassword" placeholder="Temporary password" />
                            </div>
                            <div class="form-group">
                                <label for="admin-role">Role</label>
                                <select id="admin-role" class="form-control" @bind="newStaff.Role">
                                    <option value="@StaffRole.Worker">Worker</option>
                                    <option value="@StaffRole.Admin">Admin</option>
                                </select>
                            </div>
                        </div>
                        <button class="btn btn-primary" @onclick="AddStaff">Add Staff Member</button>
                    </div>

                    <!-- Staff list -->
                    <h3 class="admin-subheading">Current Staff</h3>
                    @if (staffRowError != null)
                    {
                        <div class="booking-error admin-inline-error">@staffRowError</div>
                    }

                    <!-- MOBILE: one card per staff member. Permission checkboxes become
                         full-width toggle rows — at 13px in a table cell they were far
                         too small to hit on touch, and the table itself was hidden. -->
                    <div class="admin-mobile-cards">
                        @foreach (var member in _allStaff)
                        {
                            var m = member;
                            var isCurrentUser = m.Id == loggedInStaff.Id;
                            <div class="admin-edit-card">
                                <div class="admin-edit-card__title">
                                    @m.FullName
                                    @if (isCurrentUser) { <span class="text-muted-sm">(you)</span> }
                                </div>
                                <div class="admin-edit-card__meta">@m.Email</div>
                                <div class="admin-edit-card__field">
                                    <span>Role</span>
                                    <span class="status-badge status-badge--@(m.Role == StaffRole.Admin ? "confirmed" : "pending")">@m.Role</span>
                                </div>

                                @if (m.Role == StaffRole.Admin)
                                {
                                    <div class="admin-edit-card__field">
                                        <span>Permissions</span>
                                        <span class="text-muted-sm">Full access</span>
                                    </div>
                                }
                                else
                                {
                                    <label class="admin-toggle">
                                        <span>View all bookings</span>
                                        <input type="checkbox" @bind="m.CanViewAllBookings" />
                                    </label>
                                    <label class="admin-toggle">
                                        <span>Manage bookings</span>
                                        <input type="checkbox" @bind="m.CanManageBookings" />
                                    </label>
                                    <label class="admin-toggle">
                                        <span>See customer details</span>
                                        <input type="checkbox" @bind="m.CanViewCustomerDetails" />
                                    </label>
                                }

                                @if (!isCurrentUser)
                                {
                                    <label class="admin-toggle">
                                        <span>Active</span>
                                        <input type="checkbox" @bind="m.IsActive" />
                                    </label>
                                }

                                <div class="admin-edit-card__actions">
                                    <button class="btn btn-outline" @onclick="() => SaveStaffMember(m)">Save</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="admin-table-wrapper admin-table-wrapper--desktop-only">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>View All Bookings</th>
                                    <th>Manage Bookings</th>
                                    <th>Customer Details</th>
                                    <th>Status</th>
                                    <th>Save</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in _allStaff)
                                {
                                    var m = member;
                                    var isCurrentUser = m.Id == loggedInStaff.Id;
                                    <tr>
                                        <td><strong>@m.FullName</strong> @if (isCurrentUser) { <span class="text-muted-sm">(you)</span> }</td>
                                        <td class="text-muted-sm">@m.Email</td>
                                        <td>
                                            <span class="status-badge status-badge--@(m.Role == StaffRole.Admin ? "confirmed" : "pending")">
                                                @m.Role
                                            </span>
                                        </td>
                                        @if (m.Role == StaffRole.Admin)
                                        {
                                            <td colspan="3" class="text-center text-muted-sm">Full access (Admin)</td>
                                        }
                                        else
                                        {
                                            <td class="text-center">
                                                <input type="checkbox" @bind="m.CanViewAllBookings" />
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox" @bind="m.CanManageBookings" />
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox" @bind="m.CanViewCustomerDetails" />
                                            </td>
                                        }
                                        <td>
                                            @if (!isCurrentUser)
                                            {
                                                <input type="checkbox" @bind="m.IsActive" title="Active" />
                                                <span class="text-muted-sm admin-checkbox-label">Active</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted-sm">—</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="action-btn action-btn--primary"
                                                    @onclick="() => SaveStaffMember(m)">Save</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private StaffMember? loggedInStaff;

    private string activeTab = "calendar";

    // Bookings — one page at a time, filtered and searched in SQL. This used to be
    // every booking (with every photo) held in memory and re-filtered on each
    // keystroke; see BookingService.GetBookingsPage.
    private const int PageSize = 25;

    private List<Booking> _pageBookings = [];
    private int _totalMatches;
    private int _page;
    private string activeFilter = "All";
    private string searchTerm = "";
    private string sortMode = BookingService.SortUpcoming;
    private string? expandedId;
    private (int total, int today, int pending, int confirmed) stats;

    // Debounce so a burst of typing issues one query instead of one per character.
    private CancellationTokenSource? _searchDebounce;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalMatches / (double)PageSize));

    // BookingPhoto.Id -> signed URL, lazily filled the first time a booking with
    // photos is expanded (see ToggleExpand) rather than signing every booking's
    // photos up front on every load.
    private readonly Dictionary<string, string> _photoUrls = new();

    // Booking.Id -> staff notes on that job, loaded on expand for the same reason.
    private readonly Dictionary<string, List<CustomerNote>> _bookingNotes = new();

    // Customers tab
    private List<CustomerSummary> _customers = [];
    private CustomerDetail? _selectedCustomer;
    private bool _importingCustomers;
    private string customerSearch = "";
    private int _customerPage;
    private int _customerTotal;
    private CancellationTokenSource? _customerSearchDebounce;

    private int CustomerTotalPages =>
        Math.Max(1, (int)Math.Ceiling(_customerTotal / (double)CustomerService.PageSize));

    // Completing a job: which booking's note field is open, and its contents.
    private string? completeNoteBookingId;
    private string completeNoteBody = "";
    private bool completeNoteVisible;

    // Calendar tab
    private DateTime calDay = ShopClock.Today;
    private List<Booking> _calDayBookings = [];
    private string? deleteConfirmId;
    private string? cancelConfirmId;
    private string? openMenuId;

    // Notifications
    private List<Notification> _notifications = [];
    private int unreadCount;
    private bool bellOpen;

    // The panel lists unread by default, so marking all read empties it. Read ones
    // stay available behind the toggle until the retention purge removes them.
    private bool showReadNotifications;

    // Staff management
    private List<StaffMember> _allStaff = [];
    private StaffMember newStaff = new();
    private string newStaffPassword = "";
    private string? staffFormError;
    private string? staffRowError;

    // Pricing management
    private List<ServicePricing> _servicePricings = [];
    private Dictionary<string, decimal> _editPrices = [];
    private List<PriceAdjustment> _priceAdjustments = [];
    private string? _priceSaveMessage;

    private static readonly string[] Filters =
        ["All", "Today", "Pending", "Confirmed", "In Progress", "Completed", "Cancelled"];

    private bool IsAdmin => loggedInStaff?.Role == StaffRole.Admin;
    private bool CanManage => IsAdmin || loggedInStaff?.CanManageBookings == true;
    private bool CanSeeCustomerDetails => IsAdmin || loggedInStaff?.CanViewCustomerDetails == true;

    // Reference, Customer, Service, Date & Time, Status — plus the two columns the
    // header row adds conditionally. Drives the expanded detail row's colspan, so
    // these conditions must stay in step with the <th> guards in the table header.
    private int BookingColumnCount =>
        5 + (IsAdmin ? 1 : 0) + (CanManage || CanSeeCustomerDetails ? 1 : 0);
    // Today's schedule is its own small query rather than a slice of the current
    // page — the booking at 5pm today may well be on page three.
    private List<Booking> _todayBookings = [];
    private List<Booking> TodayBookings => _todayBookings;

    // The rendered page of results. Filtering and searching now happen in SQL, so
    // this is simply what came back.
    private List<Booking> FilteredBookings => _pageBookings;

    // Says which of the three reasons the list is empty for. The old text was a flat
    // "No bookings match the current filter", which read as wrong after a search and
    // as alarming on a brand-new install.
    private string CustomersEmptyMessage =>
        string.IsNullOrWhiteSpace(customerSearch)
            ? "No customer accounts yet."
            : $"No customers match \u201c{customerSearch.Trim()}\u201d.";

    private string BookingsEmptyMessage =>
        !string.IsNullOrWhiteSpace(searchTerm) ? $"No bookings match \u201c{searchTerm.Trim()}\u201d."
        : activeFilter != "All"               ? $"No {activeFilter.ToLowerInvariant()} bookings."
                                              : "No bookings yet.";

    // True when a booking has any actionable controls for the current user —
    // used to decide whether to render the action area / Actions column at all.
    private bool RowHasActions(Booking b) =>
        CanManage || (CanSeeCustomerDetails && AuthService.IsValidPhone(b.CustomerPhone));

    // One shared action set, reused by the Bookings cards, the Bookings table and
    // the Calendar so every view offers the exact same lifecycle + contact + delete
    // controls. Each call site keeps its own wrapper element for layout/spacing.
    @* Delete used to sit in the action strip, one tap from Cancel and wearing the same
       red. They are not peers: Cancel means "this isn't happening" and keeps the record,
       Delete removes the row and its photos from Supabase Storage for good. It lives in
       the expanded detail now, admin-only, so reaching it is a decision rather than a
       mis-tap. Note that job notes SURVIVE this (CustomerNote.BookingId is SET NULL), so
       on a guest booking a note becomes unreachable from any screen. *@
    private RenderFragment<Booking> DangerZone => booking => @<text>
        @if (IsAdmin)
        {
            <div class="booking-danger" @onclick:stopPropagation="true">
                @if (deleteConfirmId == booking.Id)
                {
                    <p class="booking-danger__text">
                        Permanently delete <strong>@booking.Reference</strong> and its photos?
                        This can't be undone — use Cancel if you just want to free the slot.
                    </p>
                    <div class="booking-danger__actions">
                        <button class="action-btn action-btn--danger"
                                @onclick="() => DeleteBooking(booking.Id)">Delete permanently</button>
                        <button class="action-btn action-btn--keep"
                                @onclick="() => deleteConfirmId = null">Keep</button>
                    </div>
                }
                else
                {
                    <button class="action-btn action-btn--delete"
                            @onclick="() => StartDelete(booking.Id)">
                        <Icon Name="trash" /> Delete booking
                    </button>
                }
            </div>
        }
    </text>;

    private RenderFragment<Booking> ActionButtons => booking => @<text>
        <div class="booking-actions">
            @* ── Tier 1: the one thing you came here to do ────────────────────
               Confirm / In Progress / Complete were three differently-coloured
               buttons for what is really one control — they were already mutually
               exclusive, so only ever one showed. Now they share the primary slot
               and read as the next step rather than the state they set. *@
            @if (CanManage && BookingService.NextStage(booking.Status) is { } next)
            {
                <button class="action-btn action-btn--primary"
                        @onclick="() => AdvanceStage(booking, next)">@StageLabel(next)</button>
            }

            @* ── Tier 2: contact. These change nothing — they are just links, so
               they sit quieter than anything that does.
               IsValidPhone rather than a blank check: older bookings predate the
               phone being required, and a value with no dialable digits produced a
               WhatsApp link to wa.me/ with no number and an empty tel: link. *@
            @if (CanSeeCustomerDetails && AuthService.IsValidPhone(booking.CustomerPhone))
            {
                <a class="action-btn action-btn--icon action-btn--whatsapp"
                   href="@WhatsAppHref(booking)" target="_blank" rel="noopener"
                   title="WhatsApp @booking.CustomerName">
                    <Icon Name="whatsapp" Label="@($"WhatsApp {booking.CustomerName}")" />
                </a>
                <a class="action-btn action-btn--icon action-btn--call"
                   href="@TelHref(booking.CustomerPhone)"
                   title="Call @booking.CustomerName">
                    <Icon Name="phone" Label="@($"Call {booking.CustomerName}")" />
                </a>
            }

            @* ── Tier 3: everything that needs a moment's thought. ───────────── *@
            @if (CanManage)
            {
                <div class="booking-menu">
                    <button class="action-btn action-btn--icon booking-menu__toggle"
                            aria-haspopup="true" aria-expanded="@(openMenuId == booking.Id)"
                            @onclick="() => ToggleMenu(booking.Id)">
                        <Icon Name="more" Label="More actions" />
                    </button>

                    @if (openMenuId == booking.Id)
                    {
                        @* A transparent backdrop rather than a document-level JS
                           listener: openMenuId is server-side state on the circuit, so
                           a click JS swallows outside Blazor could never close it. *@
                        <div class="booking-menu__backdrop"
                             @onclick="() => openMenuId = null"
                             @onclick:stopPropagation="true"></div>
                        <div class="booking-menu__panel" role="menu">
                            @if (BookingService.CanTransition(booking.Status, BookingStatus.Cancelled))
                            {
                                <button class="booking-menu__item booking-menu__item--danger" role="menuitem"
                                        @onclick="() => StartCancel(booking.Id)">Cancel booking…</button>
                            }
                            @* Reopen is what makes a mis-tap survivable. Without it the
                               only way back from a wrong Cancel was to delete the
                               booking and re-key it, which is why Delete got reached
                               for far more often than it should have been. *@
                            @if (BookingService.CanTransition(booking.Status, BookingStatus.Confirmed)
                                 && booking.Status is BookingStatus.Cancelled or BookingStatus.Completed)
                            {
                                <button class="booking-menu__item" role="menuitem"
                                        @onclick="() => ReopenBooking(booking)">
                                    <Icon Name="undo" /> Reopen booking
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Cancel now emails the customer and cannot be undone except by Reopen, so it
           gets the same two-step confirm Delete has always had. It used to fire on a
           single click. *@
        @if (cancelConfirmId == booking.Id)
        {
            <div class="booking-confirm" @onclick:stopPropagation="true">
                <p class="booking-confirm__text">
                    Cancel <strong>@booking.Reference</strong> and free the slot?
                    @if (!string.IsNullOrWhiteSpace(booking.CustomerEmail))
                    {
                        <span>@booking.CustomerName will be emailed.</span>
                    }
                </p>
                <div class="booking-confirm__actions">
                    <button class="action-btn action-btn--danger"
                            @onclick="() => CancelBooking(booking)">Yes, cancel it</button>
                    <button class="action-btn action-btn--keep"
                            @onclick="() => cancelConfirmId = null">Keep booking</button>
                </div>
            </div>
        }

        @* Sits on its own line below the buttons, so it reads as a step rather than
           another control crammed into the row. *@
        @if (completeNoteBookingId == booking.Id)
        {
            <div class="complete-note" @onclick:stopPropagation="true">
                @* Per-booking id: the mobile cards and the desktop table are BOTH always
                   in the DOM (CSS swaps them at 768px), so a literal id here put two
                   elements with the same id on the page and bound the label to the
                   wrong one. *@
                <label class="complete-note__label" for="@($"complete-note-{booking.Id}")">
                    Add a note about this job <span class="complete-note__optional">(optional)</span>
                </label>
                <textarea id="@($"complete-note-{booking.Id}")" class="form-control" rows="3"
                          placeholder="e.g. rear hub has play — worth replacing next service"
                          @bind="completeNoteBody" @bind:event="oninput"></textarea>

                <label class="complete-note__share">
                    <input type="checkbox" @bind="completeNoteVisible" />
                    <span>Share this with the customer</span>
                </label>
                <p class="complete-note__hint">
                    @(completeNoteVisible
                        ? "They'll see it on this booking in their account."
                        : "Staff only — not shown to the customer.")
                </p>

                <div class="complete-note__actions">
                    <button class="action-btn action-btn--primary" @onclick="() => CompleteWithNote(booking)">
                        @(string.IsNullOrWhiteSpace(completeNoteBody) ? "Complete without a note" : "Save note & complete")
                    </button>
                    <button class="action-btn action-btn--keep" @onclick="CancelCompleteNote">Back</button>
                </div>
            </div>
        }
    </text>;

    // The cookie carries the staff id; re-fetch the full record so permission and
    // role changes (or a deactivation) take effect on the next page load rather
    // than being frozen into the cookie's claims.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        var staffId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        loggedInStaff = staffId is null ? null : AuthService.GetStaffById(staffId);
        if (loggedInStaff is null)
        {
            // Authorized by cookie but the account is gone/deactivated — clear it.
            Nav.NavigateTo("/auth/logout", forceLoad: true);
            return;
        }

        LoadBookings();
        RefreshStats();
        LoadCalDay();  // Calendar is the default tab, so it needs data on first render.
        if (IsAdmin) _allStaff = AuthService.GetAllStaff();

        LoadNotifications();
        NotificationHub.Raised += OnNotificationRaised;
    }

    // ── Notifications ────────────────────────────────────────────────────────
    // The hub raises on whichever thread created the notification — a different
    // circuit's thread, usually — so everything here marshals onto this component's
    // dispatcher before touching state or re-rendering.
    private void OnNotificationRaised(Notification notification)
    {
        // Broadcasts (null target) reach everyone; a targeted one only its recipient.
        if (notification.TargetStaffId is not null && notification.TargetStaffId != loggedInStaff?.Id)
            return;

        _ = InvokeAsync(() =>
        {
            LoadNotifications();
            StateHasChanged();
        });
    }

    private void LoadNotifications()
    {
        if (loggedInStaff is null) return;
        _notifications = Notifications.GetRecent(loggedInStaff.Id, unreadOnly: !showReadNotifications);
        unreadCount = Notifications.UnreadCount(loggedInStaff.Id);
    }

    private void ToggleBell()
    {
        bellOpen = !bellOpen;
        if (bellOpen) LoadNotifications();
    }

    private void ToggleShowRead()
    {
        showReadNotifications = !showReadNotifications;
        LoadNotifications();
    }

    private void MarkAllRead()
    {
        Notifications.MarkAllRead(loggedInStaff!.Id);
        LoadNotifications();
    }

    // Short relative time — "4m", "2h", "3d" — so the panel stays scannable.
    private static string RelativeTime(DateTime when)
    {
        var elapsed = ShopClock.Now - when;
        if (elapsed < TimeSpan.FromMinutes(1)) return "just now";
        if (elapsed < TimeSpan.FromHours(1))   return $"{(int)elapsed.TotalMinutes}m";
        if (elapsed < TimeSpan.FromDays(1))    return $"{(int)elapsed.TotalHours}h";
        if (elapsed < TimeSpan.FromDays(7))    return $"{(int)elapsed.TotalDays}d";
        return when.ToString("d MMM", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    }

    // Unsubscribing matters: the hub is a singleton, so a leaked handler would keep
    // this circuit's component alive for the life of the process.
    public void Dispose()
    {
        NotificationHub.Raised -= OnNotificationRaised;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _customerSearchDebounce?.Cancel();
        _customerSearchDebounce?.Dispose();
    }

    private void Logout() => Nav.NavigateTo("/auth/logout", forceLoad: true);

    // Workers without CanViewAllBookings only ever see what's assigned to them; that
    // restriction is applied in the query rather than after it.
    private string? BookingScopeStaffId =>
        IsAdmin || loggedInStaff?.CanViewAllBookings == true ? null : loggedInStaff!.Id;

    private void LoadBookings()
    {
        var (items, total) = BookingService.GetBookingsPage(
            BookingScopeStaffId, activeFilter, searchTerm, _page, PageSize, sortMode);

        // A delete or a status change can shrink the result set past the current page;
        // step back rather than showing an empty list with a pager that says otherwise.
        if (items.Count == 0 && _page > 0 && total > 0)
        {
            _page = Math.Max(0, (int)Math.Ceiling(total / (double)PageSize) - 1);
            (items, total) = BookingService.GetBookingsPage(
                BookingScopeStaffId, activeFilter, searchTerm, _page, PageSize, sortMode);
        }

        _pageBookings = items;
        _totalMatches = total;

        // Today's schedule banner is only shown on the unfiltered view.
        _todayBookings = activeFilter == "All"
            ? BookingService.GetBookingsPage(BookingScopeStaffId, "Today", null, 0, PageSize).items
            : [];
    }

    private void GoToPage(int page)
    {
        _page = Math.Clamp(page, 0, TotalPages - 1);
        expandedId = null;
        CloseTransientPanels();
        LoadBookings();
    }

    private void RefreshStats()
    {
        stats = IsAdmin || loggedInStaff?.CanViewAllBookings == true
            ? BookingService.GetStats()
            : BookingService.GetStatsForStaff(loggedInStaff!.Id);
    }

    private void SetFilter(string f)
    {
        activeFilter = f;
        expandedId = null;
        CloseTransientPanels();
        _page = 0;          // a new filter starts at the first page
        LoadBookings();
    }

    private void SetSort(ChangeEventArgs e)
    {
        sortMode = e.Value?.ToString() ?? BookingService.SortUpcoming;
        expandedId = null;
        CloseTransientPanels();
