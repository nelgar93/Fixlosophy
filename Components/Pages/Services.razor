@page "/services"
@inject BookingService BookingService

<PageTitle>Services – Fixlosophy Bike Repair</PageTitle>

<div class="page-hero page-hero--sm">
    <div class="container">
        <p class="section-eyebrow">What We Offer</p>
        <h1>Our Services</h1>
        <p>Professional bike care for every rider, every budget.</p>
    </div>
</div>

<section class="section">
    <div class="container">

        <!-- SERVICING PACKAGES -->
        <div class="services-category">
            <h2 class="category-title"><span class="cat-icon"><Icon Name="wrench" /></span> Servicing Packages</h2>
            <div class="package-grid">
                @{
                    var basicPrice = _priceMap.GetValueOrDefault("Basic Service");
                    var fullPrice  = _priceMap.GetValueOrDefault("Full Service");
                    var goldPrice  = _priceMap.GetValueOrDefault("Gold Service");
                }
                <div class="package-card">
                    <div class="package-header">
                        <h3>Basic Service</h3>
                        <div class="package-price">£@basicPrice</div>
                    </div>
                    <ul>
                        <li><Icon Name="check" /> Gear indexing (front &amp; rear)</li>
                        <li><Icon Name="check" /> Brake adjustment</li>
                        <li><Icon Name="check" /> Tyre pressure check</li>
                        <li><Icon Name="check" /> Chain lube &amp; inspection</li>
                        <li><Icon Name="check" /> Safety check</li>
                    </ul>
                    <a href="/book" class="btn btn-outline">Book Now</a>
                </div>
                <div class="package-card package-card--popular">
                    <div class="package-badge">Most Popular</div>
                    <div class="package-header">
                        <h3>Full Service</h3>
                        <div class="package-price">£@fullPrice</div>
                    </div>
                    <ul>
                        <li><Icon Name="check" /> Everything in Basic Service</li>
                        <li><Icon Name="check" /> Full drivetrain clean</li>
                        <li><Icon Name="check" /> Cable &amp; housing check</li>
                        <li><Icon Name="check" /> Wheel true &amp; spoke check</li>
                        <li><Icon Name="check" /> Bearing inspection</li>
                    </ul>
                    <a href="/book" class="btn btn-primary">Book Now</a>
                </div>
                <div class="package-card">
                    <div class="package-header">
                        <h3>Gold Service</h3>
                        <div class="package-price">£@goldPrice</div>
                    </div>
                    <ul>
                        <li><Icon Name="check" /> Complete disassembly</li>
                        <li><Icon Name="check" /> Deep clean &amp; degrease</li>
                        <li><Icon Name="check" /> New cables &amp; housing</li>
                        <li><Icon Name="check" /> Bearing service &amp; repack</li>
                        <li><Icon Name="check" /> Full drivetrain overhaul</li>
                        <li><Icon Name="check" /> Written service report</li>
                    </ul>
                    <a href="/book" class="btn btn-outline">Book Now</a>
                </div>
            </div>
        </div>

        <!-- SPECIALIST -->
        @if (_servicesByCategory.Contains("Specialist"))
        {
            <div class="services-category">
                <h2 class="category-title"><span class="cat-icon"><Icon Name="bolt" /></span> Specialist Services</h2>
                <div class="pricing-table">
                    @foreach (var svc in _servicesByCategory["Specialist"])
                    {
                        <div class="pricing-row">
                            <div class="pricing-info">
                                <h4>@svc.Name</h4>
                                <p>@svc.Duration</p>
                            </div>
                            <div class="pricing-cost">£@svc.PriceFrom</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- COMPONENTS -->
        @if (_servicesByCategory.Contains("Components"))
        {
            <div class="services-category">
                <h2 class="category-title"><span class="cat-icon"><Icon Name="link" /></span> Components &amp; Repairs</h2>
                <div class="pricing-table">
                    @foreach (var svc in _servicesByCategory["Components"])
                    {
                        <div class="pricing-row">
                            <div class="pricing-info">
                                <h4>@svc.Name</h4>
                                <p>@svc.Duration</p>
                            </div>
                            <div class="pricing-cost">£@svc.PriceFrom</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- OTHER CATEGORIES -->
        @foreach (var cat in _servicesByCategory.Select(g => g.Key)
                                                 .Where(k => k != "Servicing Packages" && k != "Specialist" && k != "Components"))
        {
            <div class="services-category">
                <h2 class="category-title">@cat</h2>
                <div class="pricing-table">
                    @foreach (var svc in _servicesByCategory[cat])
                    {
                        <div class="pricing-row">
                            <div class="pricing-info">
                                <h4>@svc.Name</h4>
                                <p>@svc.Duration</p>
                            </div>
                            <div class="pricing-cost">
                                @(svc.PriceFrom > 0 ? $"£{svc.PriceFrom}" : "Quote on request")
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="services-note">
            <p><Icon Name="info" /> Prices shown are for labour only. Parts quoted separately. Final price confirmed before work begins.</p>
            <a href="/book" class="btn btn-primary btn-lg">Book Now</a>
        </div>

    </div>
</section>

@code {
    private ILookup<string, ServiceOption> _servicesByCategory = Enumerable.Empty<ServiceOption>().ToLookup(s => s.Category);
    private Dictionary<string, decimal> _priceMap = [];

    protected override void OnInitialized()
    {
        var services = BookingService.GetServices();
        _servicesByCategory = services.ToLookup(s => s.Category);
        _priceMap = services.ToDictionary(s => s.Name, s => s.PriceFrom);
    }
}
