# Copy to /etc/fixlosophy/backup.env — root-owned, chmod 600.
# Read by backup.sh. Nothing here belongs in the repo.

# Postgres connection for pg_dump.
#
# Supabase: use the SESSION pooler (port 5432) or the direct host — NOT the transaction
# pooler on 6543. pg_dump needs a session it can hold open, and the transaction pooler
# will not give it one; the failure looks like a confusing protocol error rather than
# an honest refusal.
PG_URL=postgres://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# The PUBLIC half of an age key pair. Generate with `age-keygen` on your own machine
# and keep the private half there — a backup a compromised VPS can also decrypt is not
# much of a backup, and this is what makes restoring a deliberate act from your laptop.
AGE_RECIPIENT=age1qyqszqgpqyqszqgpqyqszqgpqyqszqgpqyqszqgpqyqszqgpqyqs3ns3lq

# Where dumps land locally, and how many are kept.
BACKUP_DIR=/var/backups/fixlosophy
KEEP_DAILY=7
KEEP_WEEKLY=4

# Off-box copy. Strongly recommended — without it every backup lives on the one machine
# whose failure you are backing up against. Configure with `rclone config` first.
# Cloudflare R2 and Backblaze B2 both have free tiers far bigger than this database.
RCLONE_REMOTE=r2:fixlosophy-backups

# Dead-man's switch (healthchecks.io free tier). The script pings this on success and
# <url>/fail on failure, so you hear about a backup that stopped running at all —
# which a checker living on this same machine could never tell you.
HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
