<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Separate from Fixlosophy.Tests on purpose.

    That project's virtue is that it needs nothing: no browser, no database, no
    secrets, so it runs everywhere in about two seconds and is the suite people
    actually run before pushing. Adding Playwright to it would put a browser download
    and a slower run in front of every unit test. This project carries those costs and
    keeps them out of the fast lane.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.*" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fixlosophy.csproj" />
  </ItemGroup>

</Project>
