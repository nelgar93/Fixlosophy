<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />
    <PackageReference Include="MailKit" Version="4.*" />
  </ItemGroup>

  <!-- The test projects live in subdirectories of this one; exclude them from the
       Web SDK's implicit **/*.cs glob so their files are not compiled in twice.
       The wildcard covers Fixlosophy.Tests and Fixlosophy.Tests.E2E — miss the second
       and its Playwright fixtures land in the web assembly, which fails to build. -->
  <ItemGroup>
    <Compile Remove="Fixlosophy.Tests*/**/*.cs" />
    <Content Remove="Fixlosophy.Tests*/**" />
    <None Remove="Fixlosophy.Tests*/**" />
  </ItemGroup>

</Project>
